-- Chuyển trang + đổi kích thước đảo. dir = 1 / -1 để trượt ngang, nil = không trượt
local function rawSetPage(name, dir)
	current = name

	for n, p in pairs(pages) do
		if n ~= name and p.Visible then
			local out = dir and UDim2.new(0.5, -dir * 42, 0.5, 0) or UDim2.fromScale(0.5, 0.5)
			tw(p, 0.16, { GroupTransparency = 1, Position = out }, EZ.Quad)
			tw(p.S, 0.16, { Scale = 0.9 }, EZ.Quad)
			task.delay(0.18, function()
				if current ~= n then p.Visible = false end
			end)
		end
	end

	-- đảo nở ra → lò xo mềm, nảy nhiều; thu lại → cứng hơn, ít nảy
	local dim = LAYOUT[name or "idle"]
	local expanding = dim[1] * dim[2] > sw.t * sh.t
	local f, d = expanding and 3.3 or 4.2, expanding and 0.56 or 0.8
	sw.f, sw.d, sh.f, sh.d = f * 1.08, d, f * 0.94, d
	sw.t, sh.t = dim[1], dim[2]

	if name then
		local p = pages[name]
		p.Visible = true
		p.GroupTransparency = 1
		p.S.Scale = 0.86
		p.Position = UDim2.new(0.5, (dir or 0) * 42, 0.5, 0)
		task.delay(0.09, function()
			if alive and current == name then
				tw(p, 0.4, { GroupTransparency = 0, Position = UDim2.fromScale(0.5, 0.5) })
				tw(p.S, 0.6, { Scale = 1 }, EZ.Back)
				enterExtras(name)
			end
		end)
	end

	local showDots = (name == "stats" or name == "player" or name == "clock")
	dotsShown = showDots
	if showDots then
		dotsGroup.Visible = true
		tw(dotsGroup, 0.35, { GroupTransparency = 0 })
	else
		tw(dotsGroup, 0.15, { GroupTransparency = 1 })
		task.delay(0.2, function() if not dotsShown then dotsGroup.Visible = false end end)
	end
end

-- ── CHUYỂN TRẠNG THÁI: đóng đảo lại rồi mới mở ra lại ──────────
-- (không đổi nội dung ngay khi đang mở; mọi lần chuyển trang / thông báo đều đi qua đây)
local CLOSE_WAIT = 0.45 -- chờ đảo thu xong rồi mới mở
local transToken = 0
local function restPage() return CONFIG.RestMode == "compact" and "compact" or nil end
local function isOpenPage(n) return n == "stats" or n == "player" or n == "clock" or n == "notify" end

local function setPage(name, dir) -- gọi trực tiếp: huỷ mọi lần "mở lại" đang chờ
	transToken += 1
	rawSetPage(name, dir)
end

local function reopenWith(name) -- đóng lại → chờ → mở trang mới
	transToken += 1
	local my = transToken
	rawSetPage(restPage())
	task.delay(CLOSE_WAIT, function()
		if alive and transToken == my then rawSetPage(name) end
	end)
end

local function goRest()
	mode = "rest"
	token += 1
	setPage(CONFIG.RestMode == "compact" and "compact" or nil)
end

local function expand(idx, dir)
	if not ready then return end
	local newIdx = ((idx - 1) % #ORDER) + 1
	if mode == "expanded" and current == ORDER[newIdx] then return end
	mode = "expanded"
	pageIdx = newIdx
	token += 1
	local my = token
	if isOpenPage(current) then
		reopenWith(ORDER[pageIdx]) -- đang mở trang/thông báo khác: đóng lại rồi mở
	else
		setPage(ORDER[pageIdx], dir)
	end
	updateDots()
	if CONFIG.AutoCollapse and CONFIG.AutoCollapse > 0 then
		task.delay(CONFIG.AutoCollapse, function()
			if alive and token == my and mode == "expanded" then goRest() end
		end)
	end
end

selectDot = function(i)
	if mode == "expanded" and i ~= pageIdx then expand(i, i > pageIdx and 1 or -1) end
end

-- Cập nhật số liệu (mỗi 0.5s)
local fps = 60
local function refresh()
	local f = math.floor(fps + 0.5)
	local ping = getPing()
	local mem = math.floor(Stats:GetTotalMemoryUsageMb() + 0.5)
	local fc, pc = fpsColor(f), pingColor(ping)

	cFps.Text, cDot.BackgroundColor3 = tostring(f), fc
	cPing.Text, cPing.TextColor3 = ping .. "ms", pc

	tFps.val.Text, tPing.val.Text, tMem.val.Text = tostring(f), ping .. "ms", mem .. "MB"
	tFps.fill.BackgroundColor3, tPing.fill.BackgroundColor3 = fc, pc
	tw(tFps.fill, 0.5, { Size = UDim2.fromScale(math.clamp(f / 60, 0.04, 1), 1) })
	tw(tPing.fill, 0.5, { Size = UDim2.fromScale(math.clamp(1 - ping / 300, 0.04, 1), 1) })
	tw(tMem.fill, 0.5, { Size = UDim2.fromScale(math.clamp(mem / 3000, 0.04, 1), 1) })

	pCount.Text = #Players:GetPlayers() .. "/" .. Players.MaxPlayers

	local d = os.date("*t")
	clTime.Text = os.date("%H:%M")
	clDate.Text = T().wd[d.wday] .. ", " .. os.date("%d/%m/%Y")
	clSes.Text = fmtDur(tick() - startTick)
end

-- Vòng lặp chính
local acc, frames, settledApplied = 0, 0, false
table.insert(conns, RunService.Heartbeat:Connect(function(rawDt)
	local dt = math.min(rawDt, 1 / 20)
	local moving = math.abs(sw.p - sw.t) > 0.05 or math.abs(sw.v) > 0.05
		or math.abs(sh.p - sh.t) > 0.05 or math.abs(sh.v) > 0.05
	if moving then
		step(sw, dt); step(sh, dt)
		settledApplied = false
	elseif not settledApplied then
		sw.p, sw.v, sh.p, sh.v = sw.t, 0, sh.t, 0
		settledApplied = true
		moving = true
	end
	if moving then
		local w, h = math.max(sw.p, 28), math.max(sh.p, 20)
		root.Size = UDim2.fromOffset(w, h)
		corner.CornerRadius = UDim.new(0, math.min(h / 2, capRadius))
		ringCorner.CornerRadius = UDim.new(0, math.min(h / 2, capRadius) + 23)
	end

	-- chấm FPS "thở" nhẹ
	if current == "compact" then
		cDot.BackgroundTransparency = 0.35 * (0.5 + 0.5 * math.sin(tick() * 4))
	end

	acc += rawDt
	frames += 1
	if acc >= 0.5 then
		fps = frames / acc
		acc, frames = 0, 0
		refresh()
	end
end))

