local basePos = setmetatable({}, { __mode = "k" })
local function slideIn(obj, delay, dx, dy)
	local base = basePos[obj]
	if not base then base = obj.Position; basePos[obj] = base end
	local prop = obj:IsA("TextLabel") and "TextTransparency" or "GroupTransparency"
	obj.Position = base + UDim2.fromOffset(dx or 0, dy or 0)
	obj[prop] = 1
	task.delay(delay, function()
		if alive then tw(obj, 0.55, { Position = base, [prop] = 0 }) end
	end)
end

