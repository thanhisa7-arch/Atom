local function makeDrag(handle, target, onTap)
	local dragging, mv, startIn, startP = false, false, nil, nil
	handle.InputBegan:Connect(function(input)
		if not isPointer(input) then return end
		dragging, mv = true, false
		startIn, startP = input.Position, target.Position
	end)
	table.insert(conns, UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		local t = input.UserInputType
		if t ~= Enum.UserInputType.MouseMovement and t ~= Enum.UserInputType.Touch then return end
		local d = input.Position - startIn
		if not mv and d.Magnitude > 8 then mv = true end
		if mv then
			target.Position = UDim2.new(startP.X.Scale, startP.X.Offset + d.X, startP.Y.Scale, startP.Y.Offset + d.Y)
		end
	end))
	table.insert(conns, UserInputService.InputEnded:Connect(function(input)
		if dragging and isPointer(input) then
			dragging = false
			if not mv and onTap then onTap() end
		end
	end))
end
