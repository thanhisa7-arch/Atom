local B64CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function b64decode(data)
	data = (data:gsub("[^%w%+/=]", ""))
	local lookup = {}
	for i = 1, 64 do lookup[B64CHARS:sub(i, i)] = i - 1 end
	local out, n = {}, #data
	for i = 1, n, 4 do
		local a, b = lookup[data:sub(i, i)], lookup[data:sub(i + 1, i + 1)]
		local c, d = lookup[data:sub(i + 2, i + 2)], lookup[data:sub(i + 3, i + 3)]
		if not (a and b) then break end
		local v = a * 262144 + b * 4096 + (c or 0) * 64 + (d or 0)
		out[#out + 1] = string.char(math.floor(v / 65536) % 256)
		if c then out[#out + 1] = string.char(math.floor(v / 256) % 256) end
		if d then out[#out + 1] = string.char(v % 256) end
	end
	return table.concat(out)
end

local function embeddedLogo()
	local ok, res = pcall(function()
		local gca = getcustomasset or getsynasset
		if not (writefile and gca) then return "" end
		writefile("DynamicTest_logo.png", b64decode(EMBED_LOGO_B64))
		return gca("DynamicTest_logo.png")
	end)
	return (ok and res) or ""
end

-- Thử nạp một nội dung ảnh, chờ tối đa `timeout` giây, trả về true nếu ảnh thật sự tải được
local function tryLoad(label, content, timeout)
	label.Image = content
	local done = false
	task.spawn(function()
		pcall(function() ContentProvider:PreloadAsync({ label }) end)
		done = true
	end)
	local t0 = tick()
	while not done and tick() - t0 < timeout do task.wait(0.05) end
	return label.IsLoaded == true
end

local function buildImageCandidates()
	local list, seen = {}, {}
	local function add(name, content)
		if content and content ~= "" and not seen[content] then
			seen[content] = true
			table.insert(list, { name = name, content = content })
		end
	end
	if CONFIG.UseEmbeddedLogo then add("logo nhúng", embeddedLogo()) end
	add("CONFIG.LoadingImage", resolveImage(CONFIG.LoadingImage))
	local aid = CONFIG.LoadingImageAssetId
	if aid then
		add("thumbnail", "rbxthumb://type=Asset&id=" .. aid .. "&w=420&h=420")
		add("asset id", "rbxassetid://" .. aid)
	end
	if not CONFIG.UseEmbeddedLogo then add("logo nhúng", embeddedLogo()) end
	return list
end


-- MÀN LOAD → hình vuông bay lên thành Dynamic Island, nút chuông cũng bay ra theo
local function runIntro()
	local LS = 100 -- cạnh hình vuông
	root.Position = UDim2.new(0.5, 0, 0.5, -LS / 2 - 14)
	sw.p, sh.p, sw.t, sh.t, sw.v, sh.v = 40, 40, LS, LS, 0, 0
	sw.f, sw.d, sh.f, sh.d = 3.4, 0.55, 3.0, 0.55
	settledApplied = false
	sensor.Visible = false
	launch.Visible, launch.GroupTransparency = true, 0

	-- nạp hình (nếu có)
	local launchReady, imageFailed = false, false
	task.spawn(function()
		local winner
		local tried = {}
		for _, c in ipairs(buildImageCandidates()) do
			if not alive then return end
			table.insert(tried, c.name)
			if tryLoad(launchImg, c.content, 3) then winner = c; break end
		end
		if winner then
			launchBg.Visible, launchGlyph.Visible = false, false
			fabImg.Image, fabImg.Visible, fab.Text = winner.content, true, ""
			print("[DynamicTest] logo nạp bằng: " .. winner.name)
		else
			launchImg.Image = ""
			imageFailed = true
			warn("[DynamicTest] không tải được logo (đã thử: " .. table.concat(tried, ", ") .. ")")
		end
		launchReady = true
	end)

	-- chờ: tối thiểu LoadingTime, game load xong, hình sẵn sàng (tối đa 8s) — hình vuông "thở" nhẹ
	local t0 = tick()
	local minT = CONFIG.LoadingTime or 2
	tw(loadFill, minT, { Size = UDim2.fromScale(0.92, 1) }, EZ.Quad)
	while alive and tick() - t0 < 8 and (tick() - t0 < minT or not launchReady or not game:IsLoaded()) do
		local k = LS + 4 * math.sin((tick() - t0) * 4)
		sw.t, sh.t = k, k
		task.wait(0.03)
	end
	if not alive then return end
	sw.t, sh.t = LS, LS
	tw(loadFill, 0.3, { Size = UDim2.fromScale(1, 1) })
	task.wait(0.4)
	if not alive then return end

	-- BAY LÊN: hình vuông → viên thuốc ở trên cùng
	tw(loadWrap, 0.25, { GroupTransparency = 1 }, EZ.Quad)
	goRest()
	sw.f, sw.d, sh.f, sh.d = 3.8, 0.58, 3.3, 0.58
	tw(root, 0.95, { Position = UDim2.new(0.5, 0, 0, CONFIG.TopOffset) }, EZ.Quint)
	task.delay(0.15, function()
		if alive then tw(launch, 0.55, { GroupTransparency = 1 }, EZ.Quad) end
	end)
	task.delay(0.8, function()
		if alive then sensor.Visible = true end
	end)

	-- nút chuông cũng từ chỗ đó bay ra vị trí của nó
	if CONFIG.ShowTestButton then
		local finalPos = fab.Position
		fab.Position = UDim2.new(0.5, 0, 0.5, 0)
		fabScale.Scale = 0.2
		fab.Visible = true
		task.delay(0.2, function()
			if not alive then return end
			tw(fab, 0.9, { Position = finalPos }, EZ.Quint)
			tw(fabScale, 0.75, { Scale = 1 }, EZ.Back)
		end)
	end

	task.delay(1.1, function()
		if not alive then return end
		capRadius = 44
		launch.Visible = false
		ready = true
	end)

	if CONFIG.StartupNotif or imageFailed then
		task.delay(1.6, function()
			if not alive then return end
			if imageFailed then
				DI.Notify(T().imgFail, T().imgFailHint, { kind = "warn", duration = 5 })
			elseif CONFIG.StartupNotif then
				DI.Notify(T().ready, T().hint, { kind = "success", duration = 4 })
			end
		end)
	end
end

task.spawn(runIntro)

return DI
