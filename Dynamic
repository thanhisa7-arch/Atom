local togglePanel -- gán ở phần bảng test

local pressing, pressId, longFired, moved, startPos = false, 0, false, false, Vector3.zero

local function toggleIsland()
	if notifying then skip = true return end
	if mode == "rest" then expand(pageIdx) elseif mode == "expanded" then goRest() end
end

table.insert(conns, Hit.InputBegan:Connect(function(input)
	if not ready or not isPointer(input) then return end
	pressing, longFired, moved, startPos = true, false, false, input.Position
	pressId += 1
	local id = pressId
	sw.p -= 5; sh.p -= 2 -- cảm giác "nhấn xuống"
	task.delay(0.55, function()
		if alive and pressing and pressId == id and not moved then
			longFired = true
			if togglePanel then togglePanel() end
		end
	end)
end))

table.insert(conns, UserInputService.InputChanged:Connect(function(input)
	if not pressing then return end
	local t = input.UserInputType
	if t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch then
		if (input.Position - startPos).Magnitude > 12 then moved = true end
	end
end))

table.insert(conns, UserInputService.InputEnded:Connect(function(input)
	if not pressing or not isPointer(input) then return end
	pressing = false
	if longFired then return end
	sw.p += 7 -- bật nhẹ khi thả
	local d = input.Position - startPos
	if math.abs(d.X) > 26 and math.abs(d.X) > math.abs(d.Y) then
		if mode == "expanded" then expand(d.X < 0 and pageIdx + 1 or pageIdx - 1, d.X < 0 and 1 or -1) end
	elseif d.Y < -18 then
		if not notifying and mode == "expanded" then goRest() end
	elseif d.Y > 18 then
		if not notifying and mode == "rest" then expand(pageIdx) end
	else
		toggleIsland()
	end
end))

