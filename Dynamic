-- Lấy hình cho màn load: ID Roblox, "rbxassetid://..." hoặc link ảnh (cần executor có request/writefile/getcustomasset)
local function resolveImage(src)
	if not src or src == "" then return "" end
	src = tostring(src)
	if src:sub(1, 4) ~= "http" then
		if tonumber(src) then return "rbxassetid://" .. src end
		return src
	end
	local ok, res = pcall(function()
		local req = (syn and syn.request) or request or http_request
		local gca = getcustomasset or getsynasset
		if not (req and gca and writefile) then return "" end
		local r = req({ Url = src, Method = "GET" })
		if not r or not r.Body or #r.Body == 0 then return "" end
		writefile("DynamicTest_launch.png", r.Body)
		return gca("DynamicTest_launch.png")
	end)
	return (ok and res) or ""
end

