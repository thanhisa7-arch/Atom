local theme = { accent = Color3.fromRGB(0, 198, 255) }
local accentTargets = {}
local accentFns = {}

local function accent2()
	local h, s, v = theme.accent:ToHSV()
	return Color3.fromHSV((h + 0.1) % 1, s, v)
end

local function accent(inst, prop)
	table.insert(accentTargets, { inst, prop })
	inst[prop] = theme.accent
end

local function onAccent(fn)
	table.insert(accentFns, fn)
	fn()
end

local function accentGrad(inst, rotation)
	local g = Instance.new("UIGradient")
	g.Rotation = rotation or 0
	g.Parent = inst
	onAccent(function()
		g.Color = ColorSequence.new(theme.accent:Lerp(WHITE, 0.12), accent2())
	end)
	return g
end

local accentVal = Instance.new("Color3Value")
accentVal.Value = theme.accent
accentVal.Changed:Connect(function(c)
	theme.accent = c
	for _, t in ipairs(accentTargets) do
		t[1][t[2]] = c
	end
	for _, fn in ipairs(accentFns) do
		fn()
	end
end)

local function setAccent(color)
	tween(accentVal, 0.5, { Value = color }, EASE.Quad)
end

