local function selectTab(index, instant)
	if index == currentTab then return end
	local prev = currentTab
	currentTab = index
	local dir = (prev == 0 or index > prev) and 1 or -1
	local rest = UDim2.fromOffset(-8, -8)

	for i, g in ipairs(groups) do
		if i == index then
			g.Visible = true
			if instant or prev == 0 then
				g.Position = rest
				g.GroupTransparency = 0
			else
				g.Position = UDim2.fromOffset(-8, -8 + 22 * dir)
				g.GroupTransparency = 1
				tween(g, 0.4, { Position = rest, GroupTransparency = 0 })
				stagger(pages[i])
			end
		elseif i == prev and not instant then
			local t = tween(g, 0.16, {
				Position = UDim2.fromOffset(-8, -8 - 22 * dir),
				GroupTransparency = 1,
			}, EASE.Quad, DIR.In)
			t.Completed:Connect(function()
				if currentTab ~= i then g.Visible = false end
			end)
		else
			g.Visible = false
		end
	end

	for i, r in ipairs(tabRows) do
		local on = (i == index)
		tween(r.text, 0.25, { TextColor3 = on and WHITE or C.muted }, EASE.Quad)
		tween(r.chip, 0.25, { TextColor3 = on and theme.accent or C.gray }, EASE.Quad)
	end

	local selTarget = UDim2.fromOffset(10, rowY(index))
	local barTarget = UDim2.fromOffset(0, rowY(index) + 10)
	if instant or prev == 0 then
		tabSel.Position = selTarget
		tabBar.Position = barTarget
	else
		tween(tabSel, 0.5, { Position = selTarget }, EASE.Back)
		tween(tabBar, 0.4, { Position = barTarget }, EASE.Quint)
	end
	setTitle(index, instant or prev == 0)
end

