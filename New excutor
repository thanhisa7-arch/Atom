local loader do
	local ok, fn = pcall(function() return loadstring end)
	if ok and type(fn) == "function" then loader = fn end
end

local function execute(code)
	if not loader then
		return false, S("no_loadstring")
	end
	if code == "" then
		return false, S("empty")
	end
	local fn, err = loader(code, "AtomHub")
	if not fn then
		return false, tostring(err)
	end

	local output = {}
	local function capture(prefix)
		return function(...)
			local parts = table.pack(...)
			for i = 1, parts.n do parts[i] = tostring(parts[i]) end
			table.insert(output, prefix .. table.concat(parts, "\t"))
		end
	end
	local env = setmetatable({
		print = capture(""),
		warn = capture("[warn] "),
		player = player,
	}, { __index = getfenv(0) })
	pcall(setfenv, fn, env)

	local results = table.pack(pcall(fn))
	if not results[1] then
		table.insert(output, "[error] " .. tostring(results[2]))
		return false, table.concat(output, "\n")
	end
	for i = 2, results.n do
		table.insert(output, "=> " .. tostring(results[i]))
	end
	if #output == 0 then
		table.insert(output, S("done"))
	end
	return true, table.concat(output, "\n")
end

