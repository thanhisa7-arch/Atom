-- Hệ thống key
----------------------------------------------------------------------
local KEY_FILE = "AtomHub/key.txt"

local function normalizeKey(k)
	return string.upper(trim(tostring(k or "")))
end

local remoteKeys
local function fetchRemoteKeys()
	if CONFIG.REMOTE_KEYS_URL == "" then return nil end
	if remoteKeys then return remoteKeys end
	local ok, res = pcall(function()
		return game:HttpGet(CONFIG.REMOTE_KEYS_URL)
	end)
	if ok and type(res) == "string" then
		remoteKeys = {}
		for line in string.gmatch(res, "[^\r\n]+") do
			local k = normalizeKey(line)
			if k ~= "" then remoteKeys[k] = true end
		end
		return remoteKeys
	end
	return nil
end

-- trả về: hợp lệ?, mã chuỗi lý do (nếu sai)
local function checkKey(raw)
	local key = normalizeKey(raw)
	if key == "" then return false, "key_empty" end
	local remote = fetchRemoteKeys()
	if remote and remote[key] then return true end
	for k, v in pairs(CONFIG.KEYS) do
		if normalizeKey(k) == key then
			if v == true then return true end
			if type(v) == "number" then
				if os.time() <= v then return true end
				return false, "key_expired"
			end
		end
	end
	return false, "key_bad"
end

local function saveKey(k)
	if not (CONFIG.REMEMBER_KEY and hasFS()) then return end
	ensureFolder()
	pcall(function() writefile(KEY_FILE, k) end)
end

local function loadSavedKey()
	if not (CONFIG.REMEMBER_KEY and hasFS()) then return nil end
	local ok, res = pcall(function()
		if isfile(KEY_FILE) then return readfile(KEY_FILE) end
	end)
	if ok and type(res) == "string" then return res end
	return nil
end

local function runKeyGate(onSuccess)
	local KW, KH = 380, 300

	local keyRoot = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 24),
		Size = UDim2.fromOffset(KW, KH),
		BackgroundTransparency = 1,
		ZIndex = 15,
	}, gui)
	local keyScale = new("UIScale", { Scale = 0.9 }, keyRoot)
	local fit, ready = 1, false
	local function updateFit()
		local vp = gui.AbsoluteSize
		if vp.X > 0 and vp.Y > 0 then
			fit = math.clamp(math.min(vp.X * 0.9 / KW, vp.Y * 0.8 / KH), 0.4, 1.2)
			if ready then keyScale.Scale = fit end
		end
	end
	updateFit()
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateFit)

	-- bóng + quầng sáng
	local kShadows = {}
	for i = 1, 2 do
		local base = (i == 2) and 0.93 or 0.9
		local s = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 6),
			Size = UDim2.new(1, i * 12, 1, i * 12),
			BackgroundColor3 = (i == 2) and theme.accent or BLACK,
			BackgroundTransparency = 1,
			ZIndex = 1,
		}, keyRoot)
		corner(s, 18 + i * 8)
		if i == 2 then accent(s, "BackgroundColor3") end
		table.insert(kShadows, { s, base })
	end

	local body = new("CanvasGroup", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		ZIndex = 2,
		Active = true,
	}, keyRoot)
	corner(body, 18)
	bgFill(body, C.bgTop, C.bgBot, 120)
	makeDraggable(body, keyRoot)

	local kBorder = new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 3,
	}, keyRoot)
	corner(kBorder, 18)
	local kStroke = stroke(kBorder, WHITE, 2, 1)
	local kGrad = Instance.new("UIGradient")
	kGrad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.25, 0.5),
		NumberSequenceKeypoint.new(0.5, 1),
		NumberSequenceKeypoint.new(0.75, 0.5),
		NumberSequenceKeypoint.new(1, 0),
	})
	kGrad.Parent = kStroke
	onAccent(function()
		kGrad.Color = ColorSequence.new(theme.accent:Lerp(WHITE, 0.3), accent2())
	end)
	local kSpin = TweenService:Create(
		kGrad, TweenInfo.new(6, EASE.Linear, DIR.Out, -1), { Rotation = 360 }
	)
	kSpin:Play()

	-- nội dung
	makeAtom(body, 72, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 16),
	}, { spin = 14 })

	local title = label(body, {
		Position = UDim2.new(0, 0, 0, 94),
		Size = UDim2.new(1, 0, 0, 30),
		Text = "ATOM HUB",
		Font = Enum.Font.GothamBlack,
		TextSize = 26,
		TextColor3 = WHITE,
	})
	accentGrad(title, 0)
	local sub = label(body, {
		Position = UDim2.new(0, 0, 0, 126),
		Size = UDim2.new(1, 0, 0, 20),
		TextSize = 13,
		TextColor3 = C.muted,
	})
	tr(sub, "key_sub")

	local inputWrap = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 160),
		Size = UDim2.fromOffset(300, 42),
		BackgroundColor3 = C.dark,
		BackgroundTransparency = 0.1,
	}, body)
	corner(inputWrap, 12)
	local inStroke = stroke(inputWrap, WHITE, 1.5, 0.88)
	local input = new("TextBox", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		TextColor3 = C.text,
		PlaceholderColor3 = C.muted,
		Font = Enum.Font.Code,
		TextSize = 15,
		ClearTextOnFocus = false,
	}, inputWrap)
	tr(input, "key_ph", "PlaceholderText")
	input.Focused:Connect(function()
		tween(inStroke, 0.3, { Color = theme.accent, Transparency = 0 }, EASE.Quad)
	end)
	input.FocusLost:Connect(function()
		tween(inStroke, 0.3, { Color = WHITE, Transparency = 0.88 }, EASE.Quad)
	end)

	local status = label(body, {
		Position = UDim2.new(0, 16, 0, 210),
		Size = UDim2.new(1, -32, 0, 20),
		TextSize = 12,
		TextColor3 = C.muted,
		Text = "",
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	local function setStatus(text, color)
		status.Text = text
		status.TextColor3 = color or C.muted
	end

	local verifyBtn = primaryButton(body, {
		Position = UDim2.fromOffset(40, 242),
		Size = UDim2.fromOffset(190, 40),
	})
	tr(verifyBtn, "key_verify")
	local getBtn = button(body, {
		Position = UDim2.fromOffset(238, 242),
		Size = UDim2.fromOffset(102, 40),
		TextSize = 13,
	})
	tr(getBtn, "key_get")
	local langBtn = button(body, {
		Position = UDim2.fromOffset(KW - 12 - 44, 12),
		Size = UDim2.fromOffset(44, 24),
		Text = string.upper(lang),
		TextSize = 11,
		BackgroundColor3 = C.gray,
	}, 8)
	langBtn.Activated:Connect(function()
		lang = (lang == "vi") and "en" or "vi"
		applyLang()
		moveSeg()
		langBtn.Text = string.upper(lang)
	end)

	-- mở cửa sổ key
	keyScale.Scale = fit * 0.9
	tween(keyScale, 0.6, { Scale = fit }, EASE.Exponential)
	tween(body, 0.5, { GroupTransparency = 0 }, EASE.Quad)
	tween(kStroke, 0.5, { Transparency = 0 }, EASE.Quad)
	for _, s in ipairs(kShadows) do
		tween(s[1], 0.5, { BackgroundTransparency = s[2] }, EASE.Quad)
	end
	task.delay(0.6, function() ready = true end)

	local function shake()
		task.spawn(function()
			local base = keyRoot.Position
			for _, dx in ipairs({ -14, 12, -9, 6, -3, 0 }) do
				tween(keyRoot, 0.05, { Position = base + UDim2.fromOffset(dx, 0) }, EASE.Quad)
				task.wait(0.05)
			end
		end)
	end

	local attempts, lockedUntil, busy, passed = 0, 0, false, false

	local function verify()
		if busy or passed or os.clock() < lockedUntil then return end
		busy = true
		setStatus(S("key_checking"), C.muted)
		task.spawn(function()
			task.wait(0.35)
			local raw = input.Text
			local ok, reason = checkKey(raw)
			if ok then
				passed = true
				setStatus(S("key_ok"), C.good)
				tween(inStroke, 0.3, { Color = C.good, Transparency = 0 }, EASE.Quad)
				saveKey(normalizeKey(raw))
				task.wait(0.8)
				ready = false
				kSpin:Cancel()
				tween(keyScale, 0.5, { Scale = fit * 1.06 }, EASE.Quint)
				tween(body, 0.45, { GroupTransparency = 1 }, EASE.Quad)
				tween(kStroke, 0.45, { Transparency = 1 }, EASE.Quad)
				for _, s in ipairs(kShadows) do
					tween(s[1], 0.45, { BackgroundTransparency = 1 }, EASE.Quad)
				end
				task.wait(0.5)
				keyRoot:Destroy()
				onSuccess()
				return
			end

			attempts += 1
			setStatus(S(reason or "key_bad"), C.bad)
			tween(inStroke, 0.2, { Color = C.bad, Transparency = 0 }, EASE.Quad)
			shake()
			task.delay(0.9, function()
				if not passed then
					tween(inStroke, 0.4, { Color = WHITE, Transparency = 0.88 }, EASE.Quad)
				end
			end)
			if attempts >= CONFIG.MAX_ATTEMPTS then
				attempts = 0
				lockedUntil = os.clock() + CONFIG.COOLDOWN
				task.spawn(function()
					while os.clock() < lockedUntil and keyRoot.Parent do
						setStatus(string.format(S("key_wait"), math.ceil(lockedUntil - os.clock())), C.warn)
						task.wait(0.25)
					end
					if keyRoot.Parent and not passed then setStatus("", C.muted) end
				end)
			end
			busy = false
		end)
	end

	verifyBtn.Activated:Connect(verify)
	input.FocusLost:Connect(function(enterPressed)
		if enterPressed then verify() end
	end)

	getBtn.Activated:Connect(function()
		local url = CONFIG.GET_KEY_URL
		if clipSet then
			pcall(clipSet, url)
			notify("Atom Hub", S("key_copied"), "success")
		else
			notify("Atom Hub", url, "info")
		end
		setStatus(url, C.muted)
	end)
end

