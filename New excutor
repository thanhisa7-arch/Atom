local function persist()
	if not hasFS() then return false end
	local data = { scripts = {}, current = currentScript and currentScript.id or nil, nextNum = nextNum }
	for _, s in ipairs(scriptsData) do
		table.insert(data.scripts, { id = s.id, name = s.name, code = s.code, fav = s.fav })
	end
	ensureFolder()
	local ok = pcall(function()
		writefile(SAVE_FILE, HttpService:JSONEncode(data))
	end)
	return ok
end

local function loadPersisted()
	if not hasFS() then return end
	local ok, data = pcall(function()
		if isfile(SAVE_FILE) then
			return HttpService:JSONDecode(readfile(SAVE_FILE))
		end
	end)
	if ok and type(data) == "table" and type(data.scripts) == "table" then
		for _, s in ipairs(data.scripts) do
			idCounter += 1
			local obj = {
				id = tonumber(s.id) or idCounter,
				name = tostring(s.name or "Script"),
				code = tostring(s.code or ""),
				fav = s.fav == true,
			}
			idCounter = math.max(idCounter, obj.id)
			table.insert(scriptsData, obj)
			if data.current ~= nil and obj.id == tonumber(data.current) then
				currentScript = obj
			end
		end
		nextNum = tonumber(data.nextNum) or (#scriptsData + 1)
	end
end

local function newScript(name, code, silent)
	idCounter += 1
	local s = {
		id = idCounter,
		name = name or ("Script n." .. nextNum),
		code = code or "",
		fav = false,
	}
	if not name then nextNum += 1 end
	table.insert(scriptsData, s)
	selectScript(s)
	persist()
	if not silent then
		notify(s.name, S("n_new"), "success")
	end
	return s
end

