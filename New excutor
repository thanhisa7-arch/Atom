local animToken = 0

local function openMenu()
	if isOpen then return end
	isOpen = true
	animToken += 1
	root.Visible = true
	scale.Scale = fitScale * 0.9
	tween(scale, 0.6, { Scale = fitScale }, EASE.Exponential)
	tween(winAlpha, 0.4, { Value = 0 }, EASE.Quad)
	pingRing.Visible = false
end

local function closeMenu()
	if not isOpen then return end
	isOpen = false
	animToken += 1
	local token = animToken
	pingRing.Visible = true
	tween(scale, 0.28, { Scale = fitScale * 0.94 }, EASE.Quad, DIR.In)
	local t = tween(winAlpha, 0.28, { Value = 1 }, EASE.Quad, DIR.In)
	t.Completed:Connect(function()
		if token == animToken and not isOpen then
			root.Visible = false
		end
	end)
end

local function toggleMenu()
	if isOpen then closeMenu() else openMenu() end
end

