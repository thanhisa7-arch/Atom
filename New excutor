local function stagger(page)
	local i = 0
	for _, child in ipairs(page:GetChildren()) do
		if child:IsA("GuiObject") then
			i += 1
			local final = child:GetAttribute("FinalPos")
			if not final then
				final = child.Position
				child:SetAttribute("FinalPos", final)
			end
			child.Position = final + UDim2.fromOffset(0, 18)
			task.delay(0.05 * i, function()
				tween(child, 0.6, { Position = final }, EASE.Quint)
