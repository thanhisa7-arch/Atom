local function unlock()
	unlocked = true
	toggleHolder.Visible = true
	toggleScale.Scale = 0.2
	tween(toggleScale, 0.7, { Scale = 1 }, EASE.Back)
	openMenu()
	runLoading()
end

applyLang()
moveSeg(true)
selectTab(1, true)
toggleHolder.Visible = false

if not CONFIG.KEY_SYSTEM then
	unlock()
else
	local saved = loadSavedKey()
	if saved and saved ~= "" and checkKey(saved) then
		unlock()
	else
		runKeyGate(unlock)
	end
end
