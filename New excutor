local function new(class, props, parent)
	local i = Instance.new(class)
	for k, v in pairs(props) do
		i[k] = v
	end
	i.Parent = parent
	return i
end

local function round(inst)
	return new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, inst)
end

local function corner(inst, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 8)
	c.Parent = inst
	return c
end

local function stroke(inst, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness or 1.5
	s.Transparency = transparency or 0
	s.Parent = inst
	return s
end

local function label(parent, props)
	local base = {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		TextColor3 = C.text,
		TextXAlignment = Enum.TextXAlignment.Center,
	}
	for k, v in pairs(props) do
		base[k] = v
	end
	return new("TextLabel", base, parent)
end

-- Nút có hiệu ứng hover (chuột) + nhấn (chạm), co giãn từ tâm
local function button(parent, props, radius)
	local base = {
		AutoButtonColor = false,
		BackgroundColor3 = C.gray,
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextColor3 = C.text,
	}
	for k, v in pairs(props) do
		base[k] = v
	end
	local b = new("TextButton", base, parent)
	corner(b, radius or 10)
	local pos, size = base.Position, base.Size
	if pos and size and not props.AnchorPoint and size.X.Scale == 0 and size.Y.Scale == 0 then
		b.AnchorPoint = Vector2.new(0.5, 0.5)
		b.Position = UDim2.new(
			pos.X.Scale, pos.X.Offset + size.X.Offset / 2,
			pos.Y.Scale, pos.Y.Offset + size.Y.Offset / 2
		)
	end
	local sc = Instance.new("UIScale")
	sc.Parent = b
	local hover, down = false, false
	local function update()
		tween(sc, 0.2, { Scale = down and 0.94 or (hover and 1.04 or 1) })
	end
	b.MouseEnter:Connect(function() hover = true update() end)
	b.MouseLeave:Connect(function() hover = false down = false update() end)
	b.InputBegan:Connect(function(input)
		if isPress(input) then down = true update() end
	end)
	b.InputEnded:Connect(function(input)
		if isPress(input) then down = false update() end
	end)
	return b
end

local function primaryButton(parent, props, radius)
	local b = button(parent, props, radius)
	accent(b, "BackgroundColor3")
	b.TextColor3 = C.dark
	return b
end

local function panel(parent, pos, size)
	local f = new("Frame", {
		Position = pos,
		Size = size,
		BackgroundColor3 = C.panel,
		BackgroundTransparency = 0.45,
	}, parent)
	corner(f, 14)
	stroke(f, WHITE, 1, 0.9)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(WHITE, Color3.fromRGB(170, 182, 224))
	g.Rotation = 90
	g.Parent = f
	return f
end

-- Nền gradient đặt trong Frame con. KHÔNG đặt UIGradient trực tiếp lên CanvasGroup
-- vì nó sẽ nhuộm màu toàn bộ nội dung bên trong (làm chữ bị tối).
local function bgFill(parent, c1, c2, rot)
	local f = new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 1,
	}, parent)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(c1, c2)
	g.Rotation = rot or 90
	g.Parent = f
	return f
end

-- Kéo thả (chuột + cảm ứng). onClick chỉ chạy khi KHÔNG kéo.
local function makeDraggable(handle, target, onClick)
	local dragging, dragInput, startPos, startUi, moved = false, nil, nil, nil, false

	handle.InputBegan:Connect(function(input)
		if isPress(input) then
			dragging = true
			moved = false
			startPos = input.Position
			startUi = target.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					if not moved and onClick then
						onClick()
					end
				end
			end)
		end
	end)

	handle.InputChanged:Connect(function(input)
		if isMove(input) then
			dragInput = input
		end
	end)

	UIS.InputChanged:Connect(function(input)
		if dragging and input == dragInput then
			local d = input.Position - startPos
			if d.Magnitude > 6 then
				moved = true
			end
			if moved then
				target.Position = UDim2.new(
					startUi.X.Scale, startUi.X.Offset + d.X,
					startUi.Y.Scale, startUi.Y.Offset + d.Y
				)
			end
		end
	end)
end

----------------------------------------------------------------------
-- Logo nguyên tử: hạt nhân phát sáng + 3 quỹ đạo chấm + electron chạy
----------------------------------------------------------------------
local electrons = {}

local function makeAtom(parent, size, props, opts)
	opts = opts or {}
	local base = {
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
	}
	for k, v in pairs(props or {}) do
		base[k] = v
	end
	local holder = new("Frame", base, parent)

	local dotAlpha = opts.dotAlpha or 0.5
	local eAlpha = opts.eAlpha or 0
	local a = size / 2 - math.max(2, size * 0.05)
	local b = a * 0.38
	local nDots = size >= 80 and 44 or 26
	local dotSize = math.max(1.5, size / 46)
	local eSize = opts.eSize or math.max(4, size * 0.085)

	if not opts.noNucleus then
		local nSize = size * 0.2
		local glow = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(nSize * 2, nSize * 2),
			BackgroundColor3 = theme.accent,
			BackgroundTransparency = 0.78,
			ZIndex = 2,
		}, holder)
		round(glow)
		accent(glow, "BackgroundColor3")
		TweenService:Create(
			glow,
			TweenInfo.new(1.4, EASE.Sine, DIR.InOut, -1, true),
			{ Size = UDim2.fromOffset(nSize * 2.7, nSize * 2.7), BackgroundTransparency = 0.92 }
		):Play()

		local nuc = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(nSize, nSize),
			BackgroundColor3 = WHITE,
			ZIndex = 3,
		}, holder)
		round(nuc)
		accentGrad(nuc, 45)
	end

	for i = 1, 3 do
		local orbit = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Rotation = (i - 1) * 60,
		}, holder)
		for j = 1, nDots do
			local ang = (j / nDots) * math.pi * 2
			local d = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, math.cos(ang) * a, 0.5, math.sin(ang) * b),
				Size = UDim2.fromOffset(dotSize, dotSize),
				BackgroundColor3 = theme.accent,
				BackgroundTransparency = dotAlpha,
				BorderSizePixel = 0,
			}, orbit)
			round(d)
			accent(d, "BackgroundColor3")
		end
		local e = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(eSize, eSize),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = eAlpha,
			ZIndex = 4,
		}, orbit)
		round(e)
		accent(stroke(e, theme.accent, math.min(2, math.max(1, eSize / 4)), 0.2), "Color")
		table.insert(electrons, {
			dot = e, a = a, b = b,
			phase = i * 2.1, speed = (1.1 + i * 0.3) * (opts.speed or 1),
		})
	end

	TweenService:Create(
		holder,
		TweenInfo.new(opts.spin or 26, EASE.Linear, DIR.Out, -1),
		{ Rotation = 360 }
	):Play()

	return holder
end

local atomConn = RunService.RenderStepped:Connect(function()
	local t = os.clock()
	for i = #electrons, 1, -1 do
		local e = electrons[i]
		if not e.dot.Parent then
			table.remove(electrons, i)
		else
			local ang = e.phase + t * e.speed
			e.dot.Position = UDim2.new(0.5, math.cos(ang) * e.a, 0.5, math.sin(ang) * e.b)
		end
	end
end)

