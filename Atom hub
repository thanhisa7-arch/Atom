UserInputService.InputBegan:Connect(function(input, processed)
	-- Đang chờ người dùng chọn phím mới
	if listening then
		if input.UserInputType == Enum.UserInputType.Keyboard then
			listening = false
			if input.KeyCode ~= Enum.KeyCode.Escape and input.KeyCode ~= Enum.KeyCode.Unknown then
				toggleKey = input.KeyCode
				Persist.set("settings.toggleKey", toggleKey.Name)
				notify("Phím tắt", "Đã đổi thành " .. toggleKey.Name, 3, "success")
			end
			refreshKeyLabels()
		end
		return
	end

	if processed then return end
	if introActive then return end
	if input.KeyCode == toggleKey then setVisible(not visible) end
end)

-- ---------- Tự co giãn khi đổi kích thước màn hình ----------
local function clampToScreen()
	local size = gui.AbsoluteSize

	-- Menu: giữ tâm menu không văng ra ngoài màn hình
	local mp = main.Position
	local mx = mp.X.Scale * size.X + mp.X.Offset
	local my = mp.Y.Scale * size.Y + mp.Y.Offset
	local cx = math.clamp(mx, 60, math.max(60, size.X - 60))
	local cy = math.clamp(my, 30, math.max(30, size.Y - 30))
	if cx ~= mx or cy ~= my then
		main.Position = UDim2.fromOffset(cx, cy)
	end

	-- Nút nổi: giữ trong màn hình
	local fp = floatBtn.Position
	local fx = fp.X.Scale * size.X + fp.X.Offset
	local fy = fp.Y.Scale * size.Y + fp.Y.Offset
	local nx = math.clamp(fx, 4, math.max(4, size.X - 52))
	local ny = math.clamp(fy, 4, math.max(4, size.Y - 52))
	if nx ~= fx or ny ~= fy then
		floatBtn.Position = UDim2.fromOffset(nx, ny)
	end

	-- Các nút tròn (bay, target): giữ trong màn hình
	for _, fb in ipairs({ Theme.flyBtn, Theme.targetBtn, Theme.aimBtn }) do
		if fb then
			local bp = fb.Position
			local bx = bp.X.Scale * size.X + bp.X.Offset
			local by = bp.Y.Scale * size.Y + bp.Y.Offset
			local cbx = math.clamp(bx, 4, math.max(4, size.X - 58))
			local cby = math.clamp(by, 4, math.max(4, size.Y - 58))
			if cbx ~= bx or cby ~= by then
				fb.Position = UDim2.fromOffset(cbx, cby)
			end
		end
	end
end

gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
	if visible and not introActive then
		tween(scale, 0.2, { Scale = targetScale() })
	end
	clampToScreen()
end)

