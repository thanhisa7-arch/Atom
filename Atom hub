		if MODES[modeIdx].id == "shuffle" and #pool > 1 then
			repeat nxt = pool[math.random(#pool)] until nxt ~= current
		else
			idx = idx and ((idx - 1 + dir) % #pool + 1) or 1
			nxt = pool[idx]
		end
		playSong(nxt)
