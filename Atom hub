		local function makeRoundButton(cfg)
			local SIZE = 54
			local saved = Persist.restore(cfg.posKey, nil)
			local startPos = cfg.defaultPos
			if type(saved) == "table" and type(saved.x) == "number" and type(saved.y) == "number" then
				local sz = gui.AbsoluteSize
				startPos = UDim2.fromOffset(
					math.clamp(saved.x, 4, math.max(4, sz.X - SIZE - 4)),
					math.clamp(saved.y, 4, math.max(4, sz.Y - SIZE - 4))
				)
			end

			local btn = create("TextButton", {
				Name = cfg.name,
				Size = UDim2.fromOffset(SIZE, SIZE),
				Position = startPos,
				BackgroundColor3 = PANEL,
				BackgroundTransparency = 0.4,
				Text = "",
				AutoButtonColor = false,
				ZIndex = 89,
				Visible = false,
			}, gui)
			corner(btn, SIZE / 2)
			local st = stroke(btn, 0.45, 1.5)

			local body = create("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, btn)
			create("UICorner", { CornerRadius = UDim.new(0.5, 0) }, body)
			local bodyScale = create("UIScale", { Scale = 1 }, body)
			local spec = create("Frame", {
				Size = UDim2.fromScale(0.58, 0.3),
				Position = UDim2.fromScale(0.21, 0.07),
				BackgroundColor3 = WHITE,
				BorderSizePixel = 0,
			}, body)
			create("UICorner", { CornerRadius = UDim.new(0.5, 0) }, spec)
			create("UIGradient", {
				Rotation = 90,
				Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) }),
			}, spec)
			local icon = makeIcon(body, cfg.icon, cfg.fallback, 26, UDim2.new(0.5, -13, 0.5, -13), TEXT)
			local badge = create("TextLabel", {
				Size = UDim2.fromOffset(16, 16),
				Position = UDim2.new(1, -16, 0, 0),
				BackgroundTransparency = 1,
				Text = "🔒",
				TextSize = 11,
				Visible = false,
			}, btn)

			local function release()
				tweenEx(bodyScale, 0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out, { Scale = 1 })
			end
			btn.MouseButton1Down:Connect(function()
				tweenEx(bodyScale, 0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { Scale = 0.86 })
			end)
			btn.MouseButton1Up:Connect(release)
			btn.MouseLeave:Connect(release)

			local pressing, moved, startInput, startP = false, false, nil, nil
			btn.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then
					pressing, moved = true, false
					startInput, startP = input.Position, btn.Position
				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if (input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch) and pressing then
					pressing = false
					if moved then
						local pos = btn.Position
						Persist.set(cfg.posKey, { x = pos.X.Offset, y = pos.Y.Offset })
					end
				end
			end)
			UserInputService.InputChanged:Connect(function(input)
				if pressing and not cfg.isLocked() and (input.UserInputType == Enum.UserInputType.MouseMovement
					or input.UserInputType == Enum.UserInputType.Touch) then
					local d = input.Position - startInput
					if d.Magnitude > 10 then moved = true end
					if moved then
						local size = gui.AbsoluteSize
						local x = startP.X.Scale * size.X + startP.X.Offset + d.X
						local y = startP.Y.Scale * size.Y + startP.Y.Offset + d.Y
						x = math.clamp(x, 4, math.max(4, size.X - SIZE - 4))
						y = math.clamp(y, 4, math.max(4, size.Y - SIZE - 4))
						btn.Position = UDim2.fromOffset(x, y)
					end
				end
			end)
			btn.Activated:Connect(function()
				if moved then return end
				cfg.onClick()
			end)

			return { btn = btn, stroke = st, icon = icon, badge = badge }
		end

