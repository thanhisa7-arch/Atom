		local function startOrbit()
			if not targetPlayer or not targetPlayer.Parent then
				notify("Target", "Hãy chọn người chơi mục tiêu trước.", 3, "warn")
				return
			end
			if flags.autoFarm then
				notify("Target", "Hãy tắt Auto Farm trước.", 3, "warn")
				return
			end
			local hum, root = getHumanoid(), getRoot()
			if not hum or not root then
				notify("Target", "Chưa có nhân vật.", 3, "error")
				return
			end
			if F.fly then setFlying(false) end

			tgt.on = true
			tgt.autoRotate = hum.AutoRotate
			hum.AutoRotate = false
			tgt.conn = RunService.Heartbeat:Connect(function(dt)
				if flags.autoFarm then -- Auto Farm vừa bật: nhường quyền điều khiển cho bot
					stopOrbit()
					return
				end
				local myRoot = getRoot()
				local myHum = getHumanoid()
				if not myRoot or not myHum or myHum.Health <= 0 then return end
				if not targetPlayer or not targetPlayer.Parent then return end
				local char = targetPlayer.Character
				local tRoot = char and char:FindFirstChild("HumanoidRootPart")
				if not tRoot then return end -- mục tiêu đang hồi sinh: chờ

				-- Camera bám vào mục tiêu (đứng yên) nên không bị lắc/quay theo khi bạn bay vòng quanh
				if tgt.keepCam then
					local cam = workspace.CurrentCamera
					local tHum = char:FindFirstChildOfClass("Humanoid")
					if cam and tHum and cam.CameraSubject ~= tHum then
						cam.CameraSubject = tHum
						tgt.camChanged = true
					end
				end

				tgt.angle = (tgt.angle + dt * tgt.speed * 0.5) % (math.pi * 2)
				local center = tRoot.Position
				local pos = center + Vector3.new(
					math.cos(tgt.angle) * tgt.radius,
					tgt.height,
					math.sin(tgt.angle) * tgt.radius
				)
				myRoot.CFrame = CFrame.lookAt(pos, Vector3.new(center.X, pos.Y, center.Z))
				myRoot.AssemblyLinearVelocity = Vector3.zero
				myRoot.AssemblyAngularVelocity = Vector3.zero
			end)
			table.insert(connections, tgt.conn)
			roundVisual(rb, true)
		end

