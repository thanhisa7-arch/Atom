local hasLogo = LOGO_IMAGE ~= "" and LOGO_IMAGE ~= "rbxassetid://0"

-- Ngôi sao 4 cánh tự vẽ (dùng khi chưa điền LOGO_IMAGE)
local function makeSparkle(parent, size)
	local holder = create("Frame", {
		Size = UDim2.fromOffset(size, size),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundTransparency = 1,
	}, parent)
	local fade = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.5, 0),
		NumberSequenceKeypoint.new(1, 1),
	})
	local function part(w, h)
		return create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(w, h),
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
		}, holder)
	end
	local thick = math.max(2, size * 0.07)
	create("UIGradient", { Transparency = fade }, part(size, thick))
	create("UIGradient", { Transparency = fade, Rotation = 90 }, part(thick, size))
	local glow = part(size * 0.5, size * 0.5)
	glow.BackgroundTransparency = 0.88
	corner(glow, size * 0.25)
	local core = part(size * 0.2, size * 0.2)
	corner(core, size * 0.1)
	return holder
end

-- Vẽ logo (ảnh nếu có, không thì ngôi sao tự vẽ) vào khung parent, lấp đầy khung
local function fillWithLogo(parent, sparkleSize)
	if hasLogo then
		local img = create("ImageLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Image = LOGO_IMAGE,
			ScaleType = Enum.ScaleType.Crop,
		}, parent)
		create("UICorner", { CornerRadius = UDim.new(0.5, 0) }, img)
		return img
	end
	return makeSparkle(parent, sparkleSize)
end

