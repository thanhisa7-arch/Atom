	H.blurSize = addSlider(glassCard, "Độ mờ nền", 2, 40, 14, function(v)
		blurSize = v
		updateBlur(visible)
	end)

	-- ================= LIQUID GLASS =================
	local KP = NumberSequenceKeypoint.new
	local L = {
		on = false, intensity = 0.6, speed = 0.4, t = 0,
		conn = nil, layer = nil, sheen = nil, sheenGrad = nil, gloss = nil, glossGrad = nil,
		blobs = {}, strokeGrads = {},
	}

	local function ensureLayer()
		if L.layer then return end
		L.layer = create("Frame", {
			Name = "LiquidLayer",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			ZIndex = 3,
		}, main)

		-- Các "giọt" ánh sáng trôi chậm phía sau kính
		for i = 1, 3 do
			local blob = create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(230 + 50 * i, 230 + 50 * i),
				Position = UDim2.fromScale(0.5, 0.5),
				BackgroundColor3 = Theme.accent,
				BackgroundTransparency = 0.9,
				BorderSizePixel = 0,
			}, L.layer)
			create("UICorner", { CornerRadius = UDim.new(0.5, 0) }, blob)
			create("UIGradient", {
				Rotation = 45 * i,
				Transparency = NumberSequence.new({ KP(0, 0), KP(1, 1) }),
			}, blob)
			L.blobs[i] = blob
		end

		-- Dải sáng quét ngang (ánh phản chiếu)
		L.sheen = create("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
		}, L.layer)
		corner(L.sheen, 16)
		L.sheenGrad = create("UIGradient", {
			Rotation = 28,
			Transparency = NumberSequence.new({ KP(0, 1), KP(1, 1) }),
		}, L.sheen)

		-- Lớp bóng nửa trên (như mặt kính cong)
		L.gloss = create("Frame", {
			Size = UDim2.new(1, 0, 0.5, 0),
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
		}, L.layer)
		corner(L.gloss, 16)
		L.glossGrad = create("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({ KP(0, 1), KP(1, 1) }),
		}, L.gloss)
	end

	local function applyLiquidLook()
		if not L.layer then return end
		local I = L.intensity
		L.sheenGrad.Transparency = NumberSequence.new({
			KP(0, 1), KP(0.40, 1), KP(0.5, 1 - 0.30 * I), KP(0.60, 1), KP(1, 1),
		})
		L.glossGrad.Transparency = NumberSequence.new({ KP(0, 1 - 0.22 * I), KP(1, 1) })
		for _, blob in ipairs(L.blobs) do
			blob.BackgroundTransparency = 1 - (0.10 + 0.14 * I)
		end
	end

	liquidRecolor = function()
		if not L.layer then return end
		local h, sat = Theme.accent:ToHSV()
		L.blobs[1].BackgroundColor3 = Theme.accent
		L.blobs[2].BackgroundColor3 = Color3.fromHSV((h + 0.12) % 1, math.max(sat, 0.45), 1)
		L.blobs[3].BackgroundColor3 = Color3.fromHSV((h + 0.88) % 1, math.max(sat, 0.45), 1)
	end

	-- Viền kính có ánh sáng chạy quanh
	local function attachStrokeGrads()
		for _, st in ipairs(Theme.strokes) do
			if st.Parent and not st:FindFirstChild("LiquidGrad") then
				local g = create("UIGradient", {
					Name = "LiquidGrad",
					Transparency = NumberSequence.new({ KP(0, 0.05), KP(0.25, 0.9), KP(0.5, 0.05), KP(0.75, 0.9), KP(1, 0.05) }),
				}, st)
				table.insert(L.strokeGrads, g)
			end
		end
	end
	local function detachStrokeGrads()
		for _, g in ipairs(L.strokeGrads) do
			if g.Parent then g:Destroy() end
		end
		L.strokeGrads = {}
	end

	local function liquidStep(dt)
		if not visible then return end
		L.t += dt * (0.3 + L.speed * 2.2)
		local t = L.t
		if L.sheenGrad then
			L.sheenGrad.Offset = Vector2.new((t * 0.18) % 2.6 - 1.3, 0)
		end
		for i, blob in ipairs(L.blobs) do
			blob.Position = UDim2.fromScale(
				0.5 + 0.38 * math.sin(t * 0.21 * i + i * 2),
				0.5 + 0.32 * math.cos(t * 0.17 * i + i)
			)
		end
		for _, g in ipairs(L.strokeGrads) do
			if g.Parent then g.Rotation = (t * 45) % 360 end
		end
	end

	local function setLiquid(on)
		L.on = on
		if on then
			ensureLayer()
			L.layer.Visible = true
			liquidRecolor()
			applyLiquidLook()
			attachStrokeGrads()
			Theme.liquidBoost = L.intensity
			if not L.conn then
				L.conn = RunService.Heartbeat:Connect(liquidStep)
				table.insert(connections, L.conn)
			end
		else
			if L.layer then L.layer.Visible = false end
			detachStrokeGrads()
			Theme.liquidBoost = 0
			if L.conn then
				L.conn:Disconnect()
				L.conn = nil
			end
		end
		Theme.refreshStrokes()
	end

	local liquidCard = addCard(uiPage, "Liquid Glass")
	addText(liquidCard, "Hiệu ứng kính lỏng: dải sáng quét ngang, lớp bóng cong phía trên, những giọt ánh sáng trôi chậm và viền có ánh sáng chạy quanh.")
	Persist.nextKey = "ui.liquid"
	H.liquid = addToggle(liquidCard, "Bật Liquid Glass", false, setLiquid)
