		local sz = gui.AbsoluteSize
		flyStart = UDim2.fromOffset(
			math.clamp(savedFlyPos.x, 4, math.max(4, sz.X - FLY_SIZE - 4)),
			math.clamp(savedFlyPos.y, 4, math.max(4, sz.Y - FLY_SIZE - 4))
		)
	end

	local flyBtn = create("TextButton", {
		Name = "FlyButton",
		Size = UDim2.fromOffset(FLY_SIZE, FLY_SIZE),
		Position = flyStart,
		BackgroundColor3 = PANEL,
		BackgroundTransparency = 0.4,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 90,
		Visible = false,
	}, gui)
	corner(flyBtn, FLY_SIZE / 2)
	local flyStroke = stroke(flyBtn, 0.45, 1.5)
	Theme.flyBtn = flyBtn

	local flyBody = create("CanvasGroup", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
	}, flyBtn)
	create("UICorner", { CornerRadius = UDim.new(0.5, 0) }, flyBody)
	local flyBodyScale = create("UIScale", { Scale = 1 }, flyBody)
	local flySpec = create("Frame", {
		Size = UDim2.fromScale(0.58, 0.3),
		Position = UDim2.fromScale(0.21, 0.07),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
	}, flyBody)
	create("UICorner", { CornerRadius = UDim.new(0.5, 0) }, flySpec)
	create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) }),
	}, flySpec)
	local flyIcon = makeIcon(flyBody, "plane", "✈", 26, UDim2.new(0.5, -13, 0.5, -13), TEXT)

	-- Biểu tượng ổ khoá khi nút bị khoá vị trí
