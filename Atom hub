			local btnsW = s.custom and 64 or 34
			local nameBtn = create("TextButton", {
				Size = UDim2.new(1, -btnsW - 4, 1, 0),
				BackgroundTransparency = 1,
				Text = (playing and "♪  " or "") .. s.name,
				TextColor3 = TEXT,
				Font = Enum.Font.GothamMedium,
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				AutoButtonColor = false,
			}, row)
			padding(nameBtn, 0, 0, 0, 10)
			nameBtn.MouseButton1Click:Connect(function() playSong(s) end)

			local heart = create("TextButton", {
				Size = UDim2.fromOffset(26, 26),
				Position = UDim2.new(1, -(btnsW - 2), 0.5, -13),
				BackgroundTransparency = 1,
				Text = fav[s.id] and "❤️" or "🤍",
				TextSize = 15,
				AutoButtonColor = false,
			}, row)
			heart.MouseButton1Click:Connect(function()
				fav[s.id] = (not fav[s.id]) or nil
				Persist.set("music.fav", fav)
				updateNow()
				refreshList()
			end)

			if s.custom then
				local del = create("TextButton", {
					Size = UDim2.fromOffset(26, 26),
					Position = UDim2.new(1, -30, 0.5, -13),
					BackgroundTransparency = 1,
					Text = "✕",
					TextColor3 = Color3.fromRGB(230, 110, 110),
					Font = Enum.Font.GothamBold,
					TextSize = 13,
					AutoButtonColor = false,
				}, row)
				del.MouseButton1Click:Connect(function()
					for k, cs in ipairs(customSongs) do
						if cs.id == s.id then table.remove(customSongs, k) break end
					end
					Persist.set("music.custom", customSongs)
					fav[s.id] = nil
					Persist.set("music.fav", fav)
					if current and current.id == s.id then
						sound:Stop()
						current = nil
					end
					rebuildSongs()
					updateNow()
					refreshList()
				end)
			end
		end

		if #shown == 0 then
			create("TextLabel", {
				Size = UDim2.new(1, 0, 0, 40),
				BackgroundTransparency = 1,
				Text = (#songs == 0) and "Chưa có nhạc nào. Thêm nhạc ở ô bên dưới nhé!"
					or (favOnly and q == "" and "Chưa có bài yêu thích." or "Không tìm thấy bài nào."),
				TextColor3 = SUBTEXT,
				Font = Enum.Font.Gotham,
				TextSize = 12,
				TextWrapped = true,
			}, listFrame)
		end
		countLbl.Text = #shown .. " / " .. #songs .. " bài"
	end
	searchBox:GetPropertyChangedSignal("Text"):Connect(refreshList)

	-- ================= GIAO DIỆN: THÊM NHẠC =================
	local addCardM = addCard(musicPage, "Thêm nhạc")
	local function inputBox(placeholder)
		local b = create("TextBox", {
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.94,
			Text = "",
			PlaceholderText = placeholder,
			PlaceholderColor3 = SUBTEXT,
			TextColor3 = TEXT,
			Font = Enum.Font.Gotham,
			TextSize = 12,
			ClearTextOnFocus = false,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, addCardM)
		corner(b, 8)
		padding(b, 0, 10, 0, 10)
		return b
	end
	local nameBox = inputBox("Tên bài hát (không bắt buộc)")
	local idBox = inputBox("ID audio (số) hoặc link rbxassetid://...")

	local function addCustom(play)
		local id = string.match(idBox.Text, "%d+")
		if not id or #id < 5 then
			notify("Music", "ID không hợp lệ. Hãy dán số ID audio (ít nhất 5 chữ số).", 3, "warn", true)
			return
		end
		for _, s in ipairs(songs) do
			if s.id == id then
				notify("Music", "Bài này đã có trong danh sách.", 2, "info", true)
				if play then playSong(s) end
				return
			end
		end
		local name = trim(nameBox.Text)
		if name == "" then name = "Bài " .. id end
		local ok, cut = pcall(utf8.offset, name, 61)
		if ok and cut then name = string.sub(name, 1, cut - 1) end
		table.insert(customSongs, { name = name, id = id })
		Persist.set("music.custom", customSongs)
		rebuildSongs()
		nameBox.Text, idBox.Text = "", ""
		refreshList()
		notify("Music", "Đã thêm: " .. name, 2, "success", true)
		if play then
			for _, s in ipairs(songs) do
				if s.id == id then playSong(s) break end
			end
		end
	end
	addButton(addCardM, "Thêm vào danh sách", function() addCustom(false) end)
	addButton(addCardM, "Thêm & phát ngay", function() addCustom(true) end)
	addText(addCardM, "Lấy ID: vào Creator Store (create.roblox.com/store/audio), mở một bài audio miễn phí và copy dãy số ID trên link. Bài tự thêm được lưu lại cho lần sau (nếu môi trường hỗ trợ lưu) và có thể xoá bằng nút ✕. Nhạc chỉ mình bạn nghe được.")

	refreshList()
	updateNow()
end

-- ---------- TAB: EMOTE ----------
-- Chọn emote, nhập nội dung rồi bấm Thực hiện: nhân vật viết lên bảng rồi giơ bảng ra trước ngực.
-- Bảng + tư thế tay chỉ mình bạn thấy (LocalScript không tạo được vật thể cho người khác thấy).
-- Người khác thấy: animation của Roblox + tin nhắn gửi vào chat game (công tắc "Gửi kèm vào chat game").
do
	local RS = game:GetService("ReplicatedStorage")
	local RunService = game:GetService("RunService")

	local MAX_LEN = 120
	local COOLDOWN = 1.5

	-- Animation của Roblox (có replicate cho mọi người). Sửa ID nếu game chặn / muốn đổi.
	local EMOTES = {
		{ name = "Message (viết lên bảng)", message = true,
			r15 = 507770453, r6 = 128853357 }, -- anim phụ cho người khác thấy ở chế độ local
		{ name = "Vẫy tay",  r15 = 507770239, r6 = 128777973 },
		{ name = "Chỉ tay",  r15 = 507770453, r6 = 128853357 },
		{ name = "Nhảy",     r15 = 507771019, r6 = 182435998 },
		{ name = "Cổ vũ",    r15 = 507770677, r6 = 129423030 },
		{ name = "Cười",     r15 = 507770818, r6 = 129423131 },
	}

	-- Kích thước / vị trí bảng (so với thân).
	local BOARD_SIZE = Vector3.new(3, 2, 0.15)
	local OFFSET_WRITE = CFrame.new(0, -0.4, -1.1) * CFrame.Angles(math.rad(-25), 0, 0)
	local OFFSET_HOLD = CFrame.new(0, 0.2, -1.5)

	-- Tư thế tay (độ). Vai: Z (tay phải +, tay trái -), khuỷu: X (+ = gập lên trước)
	local POSE_WRITE = { rs = Vector3.new(0, 0, 50), re = Vector3.new(70, 0, 0), ls = Vector3.new(0, 0, -60), le = Vector3.new(60, 0, 0) }
	local POSE_HOLD  = { rs = Vector3.new(0, 0, 60), re = Vector3.new(75, 0, 0), ls = Vector3.new(0, 0, -60), le = Vector3.new(75, 0, 0) }

	local function trim(s) return string.match(tostring(s or ""), "^%s*(.-)%s*$") end
	local function subChars(text, n)
		local o = utf8.offset(text, n + 1)
		return o and string.sub(text, 1, o - 1) or text
	end

	local function getRig()
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then return nil end
		local torso, m = nil, {}
		if hum.RigType == Enum.HumanoidRigType.R15 then
			torso = char:FindFirstChild("UpperTorso")
			local function mot(p, n)
				local part = char:FindFirstChild(p)
				return part and part:FindFirstChild(n)
			end
			m.rs = mot("RightUpperArm", "RightShoulder")
			m.ls = mot("LeftUpperArm", "LeftShoulder")
			m.re = mot("RightLowerArm", "RightElbow")
			m.le = mot("LeftLowerArm", "LeftElbow")
		else
			torso = char:FindFirstChild("Torso")
			m.rs = torso and torso:FindFirstChild("Right Shoulder")
			m.ls = torso and torso:FindFirstChild("Left Shoulder")
		end
		if not torso then return nil end
		return char, hum, torso, m
	end

	-- ================= ANIMATION THƯỜNG (replicate) =================
	local animTrack
	local function stopAnim()
		if animTrack then
			animTrack:Stop()
			animTrack = nil
		end
	end
	local function playAnim(e)
		local _, hum = getRig()
		if not hum then
			notify("Emote", "Chưa có nhân vật.", 2, "error", true)
			return
		end
		local id = (hum.RigType == Enum.HumanoidRigType.R15) and e.r15 or e.r6
		if not id then return end
		local animator = hum:FindFirstChildOfClass("Animator") or create("Animator", {}, hum)
		local a = create("Animation", { AnimationId = "rbxassetid://" .. id }, nil)
		stopAnim()
		local ok, tr = pcall(function() return animator:LoadAnimation(a) end)
		if not ok or not tr then
			notify("Emote", "Không tải được animation.", 3, "error", true)
			return
		end
		tr.Priority = Enum.AnimationPriority.Action
		tr:Play()
		animTrack = tr
	end

	-- ================= CHẾ ĐỘ LOCAL: bảng + tư thế (chỉ mình bạn thấy) =================
	local localToken = 0
	local localState = nil -- { board, weld }
	local poseOn = false
	local poseCur, poseTgt, poseMotors = {}, {}, {}

	table.insert(connections, RunService.RenderStepped:Connect(function(dt)
		if not poseOn then return end
		local a = math.min(1, dt * 10)
		for k, mot in pairs(poseMotors) do
			if mot and mot.Parent then
				local c = (poseCur[k] or Vector3.zero):Lerp(poseTgt[k] or Vector3.zero, a)
				poseCur[k] = c
				mot.Transform = CFrame.Angles(math.rad(c.X), math.rad(c.Y), math.rad(c.Z))
			end
		end
	end))

	local function setPose(p)
		for k in pairs(poseMotors) do poseTgt[k] = p and p[k] or Vector3.zero end
	end

	local function stopLocal()
		localToken += 1
		poseOn = false
		for _, mot in pairs(poseMotors) do
			if mot and mot.Parent then mot.Transform = CFrame.new() end
		end
		poseMotors, poseCur, poseTgt = {}, {}, {}
		if localState then
			localState.board:Destroy()
			localState = nil
		end
	end

	local function runLocalMessage(text, duration, e)
		local char, hum, torso, motors = getRig()
		if not char then
			notify("Emote", "Chưa có nhân vật.", 2, "error", true)
			return
		end
		stopLocal()
		stopAnim()
		local token = localToken
		local function alive() return token == localToken and hum.Parent and hum.Health > 0 end

		-- Anim phụ để người khác thấy bạn đang "làm gì đó"
		playAnim(e)

		local board = create("Part", {
			Name = "AtomBoardLocal",
			Size = BOARD_SIZE,
			Color = Color3.fromRGB(245, 240, 220),
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			Massless = true,
		}, char)
		local weld = create("Weld", { Part0 = torso, Part1 = board, C0 = OFFSET_WRITE }, board)
		local sg = create("SurfaceGui", {
			Face = Enum.NormalId.Front,
			SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
			PixelsPerStud = 60,
		}, board)
		local lbl = create("TextLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			TextColor3 = Color3.fromRGB(30, 30, 30),
			Font = Enum.Font.GothamBold,
			TextScaled = true,
			TextWrapped = true,
		}, sg)
		padding(lbl, 8, 8, 8, 8)
		localState = { board = board, weld = weld }

		if next(motors) then
			poseMotors, poseCur, poseTgt = motors, {}, {}
			poseOn = true
			setPose(POSE_WRITE)
		end

		-- Viết từng chữ
		local total = utf8.len(text) or #text
		for i = 1, total do
			if not alive() then stopLocal() return end
			lbl.Text = subChars(text, i)
			if i % 3 == 0 and motors.re then
				poseTgt.re = Vector3.new(55 + (i % 6 == 0 and 30 or 0), 0, 0)
			end
			task.wait(0.05)
		end

		-- Giơ bảng ra trước ngực
		setPose(POSE_HOLD)
		TweenService:Create(weld, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { C0 = OFFSET_HOLD }):Play()

		if duration > 0 then
			local t0 = os.clock()
			while os.clock() - t0 < duration do
				if not alive() then break end
				task.wait(0.2)
			end
			if token == localToken then
				stopLocal()
				stopAnim()
			end
		end
	end

	-- ================= GỬI VÀO CHAT GAME =================
	local function sendRobloxChat(msg)
		pcall(function()
			local TCS = game:GetService("TextChatService")
			local channels = TCS:FindFirstChild("TextChannels")
			local ch = channels and channels:FindFirstChild("RBXGeneral")
			if ch then
				ch:SendAsync(msg)
			else
				local ev = RS:FindFirstChild("DefaultChatSystemChatEvents")
				local say = ev and ev:FindFirstChild("SayMessageRequest")
				if say then say:FireServer(msg, "All") end
			end
		end)
	end

	-- ================= GIAO DIỆN =================
	local emotePage = addTab("Emote", "smile", "🎭")
	local selected = 1
	local lastUse = -999
	local sendChat = true
	local duration = 15

	local pickCard = addCard(emotePage, "Chọn emote")
	local modeLabel = addText(pickCard, "")
	local function refreshMode()
		modeLabel.Text = "Bảng + tư thế chỉ mình bạn thấy. Người khác thấy animation và tin nhắn trong chat game (nếu bật công tắc gửi chat)."
	end
	refreshMode()

	local listFrame = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
	}, pickCard)
	create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4) }, listFrame)

	local rowBtns = {}
	local msgCard -- khai báo trước
	local function refreshEmoteList()
		for i, b in ipairs(rowBtns) do
			local on = (i == selected)
			b.BackgroundColor3 = on and Theme.accent or WHITE
			b.BackgroundTransparency = on and 0.6 or 0.92
		end
		if msgCard then msgCard.Visible = EMOTES[selected].message == true end
	end
	for i, e in ipairs(EMOTES) do
		local b = create("TextButton", {
			Size = UDim2.new(1, 0, 0, 32),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.92,
			Text = (e.message and "💬  " or "🎭  ") .. e.name,
			TextColor3 = TEXT,
			Font = Enum.Font.GothamMedium,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			AutoButtonColor = false,
			LayoutOrder = i,
		}, listFrame)
		b:SetAttribute("NoTheme", true)
		corner(b, 6)
		padding(b, 0, 10, 0, 10)
		b.MouseButton1Click:Connect(function()
			selected = i
			refreshEmoteList()
		end)
		rowBtns[i] = b
	end
	table.insert(Theme.hooks, refreshEmoteList)

	-- Ô nhập tin nhắn
	msgCard = addCard(emotePage, "Message")
	local msgBox = create("TextBox", {
		Size = UDim2.new(1, 0, 0, 64),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.94,
		Text = "",
		PlaceholderText = "Nội dung viết lên bảng (tối đa " .. MAX_LEN .. " ký tự)...",
		PlaceholderColor3 = SUBTEXT,
		TextColor3 = TEXT,
		Font = Enum.Font.Gotham,
		TextSize = 13,
		ClearTextOnFocus = false,
		MultiLine = true,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
	}, msgCard)
	corner(msgBox, 8)
	padding(msgBox, 8, 10, 8, 10)

	Persist.nextKey = "emote.duration"
	addSlider(msgCard, "Thời gian giơ bảng (0 = đến khi bấm Dừng)", 0, 60, 15, function(v)
		duration = v
	end, "s")
	Persist.nextKey = "emote.chat"
	addToggle(msgCard, "Gửi kèm vào chat game (để người khác đọc được)", true, function(on)
		sendChat = on
	end)

	-- Nút thực hiện / dừng
	local actCard = addCard(emotePage, "Hành động")
	addButton(actCard, "▶  Thực hiện emote", function()
		if os.clock() - lastUse < COOLDOWN then
			notify("Emote", "Đợi một chút rồi bấm lại.", 2, "warn", true)
			return
		end
		local e = EMOTES[selected]
		if not e.message then
			lastUse = os.clock()
			playAnim(e)
			return
		end

		local text = trim(msgBox.Text)
		text = string.gsub(text, "%c", " ")
		if text == "" then
			notify("Emote", "Hãy nhập nội dung cần viết.", 2, "warn", true)
			return
		end
		if (utf8.len(text) or #text) > MAX_LEN then
			notify("Emote", "Tin quá dài (tối đa " .. MAX_LEN .. " ký tự).", 3, "warn", true)
			return
		end
		lastUse = os.clock()
		refreshMode()

		task.spawn(runLocalMessage, text, duration, e)
		if sendChat then sendRobloxChat(text) end
	end)
	addButton(actCard, "■  Dừng / hạ bảng", function()
		stopLocal()
		stopAnim()
	end)
