		Theme.refreshStrokes()
	end, "%")

	-- Blur nền game khi mở menu
	local blur = nil
	local blurOn, blurSize = false, 14
	local function updateBlur(isVisible)
		if not blurOn then
			if blur then tweenEx(blur, 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { Size = 0 }) end
			return
		end
		if not blur then
			blur = Instance.new("BlurEffect")
			blur.Name = "AtomBlur"
			blur.Size = 0
			blur.Parent = Lighting
		end
		tweenEx(blur, 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { Size = isVisible and blurSize or 0 })
	end
	Theme.onVisibility = function(v) updateBlur(v) end

	Persist.nextKey = "ui.blur"
	H.blur = addToggle(glassCard, "Làm mờ nền game khi mở menu", false, function(on)
		blurOn = on
		updateBlur(visible)
	end)
