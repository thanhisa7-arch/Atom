-- ---------- Hàm tiện ích ----------
local function create(class, props, parent)
	local obj = Instance.new(class)
	for k, v in pairs(props) do obj[k] = v end
	obj.Parent = parent
	return obj
end

local function corner(parent, r)
	return create("UICorner", { CornerRadius = UDim.new(0, r) }, parent)
end

local function stroke(parent, transparency, thickness)
	local st = create("UIStroke", {
		Color = Theme.accent,
		Transparency = transparency or 0.85,
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
	st:SetAttribute("BaseTransparency", transparency or 0.85)
	table.insert(Theme.strokes, st)
	return st
end

local function padding(parent, top, right, bottom, left)
	return create("UIPadding", {
		PaddingTop = UDim.new(0, top), PaddingRight = UDim.new(0, right),
		PaddingBottom = UDim.new(0, bottom), PaddingLeft = UDim.new(0, left),
	}, parent)
end

-- Cài đặt có thể thay đổi trong tab Settings
local SETTINGS = {
	animations = true,
	notifications = true,
	floatButton = true,
}

local function tween(obj, time, props)
	if not SETTINGS.animations then time = 0 end
	TweenService:Create(obj, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function tweenEx(obj, time, style, direction, props)
	if not SETTINGS.animations then time = 0 end
	local t = TweenService:Create(obj, TweenInfo.new(time, style, direction), props)
	t:Play()
	return t
end

-- ---------- Ghi nhớ cài đặt ----------
-- Nơi lưu (tự chọn):
--   1) "server": nếu game có RemoteFunction AtomSettingsLoad/AtomSettingsSave (xem AtomSettingsServer.lua)
--   2) "file"  : nếu môi trường có writefile/readfile (lưu thành tệp trên máy)
--   3) "session": chỉ nhớ trong phiên hiện tại (khi không có cách lưu lâu dài)
local Persist = { data = {}, mode = "session", pending = {}, applying = false, nextKey = nil }
do
	local HttpService = game:GetService("HttpService")
	local RS = game:GetService("ReplicatedStorage")
	local fileName = "AtomMenu_" .. tostring(player.UserId) .. ".json"
	local loadRF = RS:FindFirstChild("AtomSettingsLoad")
	local saveRF = RS:FindFirstChild("AtomSettingsSave")
	local fsOk = typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(isfile) == "function"

	if loadRF and saveRF then
		Persist.mode = "server"
		local ok, res = pcall(function() return loadRF:InvokeServer() end)
		if ok and type(res) == "table" then Persist.data = res end
	elseif fsOk then
		Persist.mode = "file"
		local ok, res = pcall(function()
			if isfile(fileName) then return HttpService:JSONDecode(readfile(fileName)) end
			return nil
		end)
		if ok and type(res) == "table" then Persist.data = res end
	else
		shared.AtomMenuSaved = shared.AtomMenuSaved or {}
		Persist.data = shared.AtomMenuSaved
	end

	local saveQueued = false
	function Persist.flush()
		if Persist.mode == "file" then
			pcall(function() writefile(fileName, HttpService:JSONEncode(Persist.data)) end)
		elseif Persist.mode == "server" then
			task.spawn(function() pcall(function() saveRF:InvokeServer(Persist.data) end) end)
		end
	end
	function Persist.set(key, value)
		Persist.data[key] = value
		if Persist.mode == "session" or saveQueued then return end
		saveQueued = true
		task.delay(1, function()
			saveQueued = false
			Persist.flush()
		end)
	end
	function Persist.clear()
		for k in pairs(Persist.data) do Persist.data[k] = nil end
		Persist.flush()
	end
end

function Persist.get(key, default)
	local v = Persist.data[key]
	if v == nil then return default end
	return v
end

-- Giá trị đã lưu (trả về mặc định nếu người dùng tắt "tự bật lại")
function Persist.restore(key, default)
	if Persist.data._auto == false then return default end
	return Persist.get(key, default)
end

function Persist.queueApply(fn)
	table.insert(Persist.pending, fn)
end

-- Chạy các cài đặt đã lưu (bật lại chức năng). Trả về số mục đã khôi phục.
function Persist.runPending()
	if Persist.data._auto == false then
		Persist.pending = {}
		return 0
	end
	local n = 0
	Persist.applying = true
	for _, fn in ipairs(Persist.pending) do
		pcall(fn)
		n += 1
		task.wait()
	end
	Persist.pending = {}
	Persist.applying = false
	return n
end

-- Bộ chuyển động chung cho viền kính của công tắc/thanh kéo (chỉ 1 vòng lặp cho tất cả)
Theme.glassActive = true
Theme.glassGrads = {}
do
	local RS = game:GetService("RunService")
	local t, acc, conn = 0, 0, nil
	function Theme.registerGrad(g)
		table.insert(Theme.glassGrads, g)
		if conn then return end
		conn = RS.Heartbeat:Connect(function(dt)
			if not Theme.glassActive then return end
			acc += dt
			if acc < 1 / 30 then return end
			t += acc
			acc = 0
			local rot = (t * 55) % 360
			for i = #Theme.glassGrads, 1, -1 do
				local gr = Theme.glassGrads[i]
				if gr.Parent then gr.Rotation = rot else table.remove(Theme.glassGrads, i) end
			end
		end)
		table.insert(connections, conn)
	end
end

