	filterBtn = addButton(libCard, "Đang xem: Tất cả  (bấm để chỉ xem bài yêu thích)", function()
		favOnly = not favOnly
		filterBtn.Text = favOnly and "Đang xem: ❤️ Yêu thích  (bấm để xem tất cả)"
