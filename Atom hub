		BorderSizePixel = 0,
	}, track)
	corner(gloss, 8)
	create("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({ KP(0, 0.7), KP(1, 1) }) }, gloss)

	-- Hạt kính: trong suốt, có đốm phản chiếu, "dãn ra" khi bấm
	local knob = create("Frame", {
		Size = UDim2.fromOffset(18, 18),
		Position = UDim2.fromOffset(3, 3),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
	}, track)
	corner(knob, 9)
	create("UIStroke", {
		Color = WHITE,
		Transparency = 0.5,
		Thickness = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, knob)
	local spec = create("Frame", {
		Size = UDim2.fromOffset(8, 5),
		Position = UDim2.fromOffset(3, 2),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
	}, knob)
	corner(spec, 3)

	local key = Persist.nextKey
	Persist.nextKey = nil
	local state = default
	if key then
		local saved = Persist.restore(key, default)
		if type(saved) == "boolean" and saved ~= default then
			state = saved
			Persist.queueApply(function() callback(saved) end)
		end
	end

	local pressed = false
	local function render()
		local w = pressed and 26 or 18
		local x = state and (44 - 3 - w) or 3
		tween(track, 0.2, {
			BackgroundColor3 = state and Theme.accent or Color3.fromRGB(60, 60, 60),
			BackgroundTransparency = state and 0.18 or 0.35,
		})
		tweenEx(knob, 0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out, {
			Size = UDim2.fromOffset(w, 18),
			Position = UDim2.fromOffset(x, 3),
		})
	end
	render()
	table.insert(Theme.hooks, render)

	local function unpress()
		if pressed then
			pressed = false
			render()
		end
	end
	track.MouseButton1Down:Connect(function()
		pressed = true
		render()
	end)
	track.MouseButton1Up:Connect(unpress)
	track.MouseLeave:Connect(unpress)

	track.MouseButton1Click:Connect(function()
		state = not state
		render()
		if key then Persist.set(key, state) end
		callback(state)
	end)
	return {
		Set = function(_, v, silent)
			if state == v then return end
			state = v
			render()
			if key then Persist.set(key, v) end
			if not silent then callback(v) end
		end,
	}
end

local function addSlider(parent, text, min, max, default, callback, suffix, onRelease)
	local KP = NumberSequenceKeypoint.new
	local row = create("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1 }, parent)
	create("TextLabel", {
		Size = UDim2.new(1, -60, 0, 18),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = TEXT,
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	local valueLabel = create("TextLabel", {
		Size = UDim2.new(0, 56, 0, 18),
		Position = UDim2.new(1, -56, 0, 0),
		BackgroundTransparency = 1,
		Text = tostring(default) .. (suffix or ""),
		TextColor3 = SUBTEXT,
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, row)

	-- Vùng bấm cao hơn thanh kéo để dễ chạm/bấm trúng
	local hit = create("TextButton", {
		Size = UDim2.new(1, 0, 0, 28),
		Position = UDim2.fromOffset(0, 17),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
	}, row)

	-- Rãnh kính: trong suốt, viền có ánh sáng chạy, vệt bóng mảnh phía trên
	local track = create("Frame", {
		Size = UDim2.new(1, 0, 0, 8),
		Position = UDim2.fromOffset(0, 27),
		BackgroundColor3 = Color3.fromRGB(60, 60, 60),
		BackgroundTransparency = 0.4,
		BorderSizePixel = 0,
	}, row)
	corner(track, 4)
	local trackStroke = stroke(track, 0.7, 1)
	Theme.registerGrad(create("UIGradient", {
		Name = "LiquidGrad",
		Transparency = NumberSequence.new({ KP(0, 0.1), KP(0.3, 0.85), KP(0.5, 0.1), KP(0.8, 0.85), KP(1, 0.1) }),
	}, trackStroke))
	local trackGloss = create("Frame", {
		Size = UDim2.new(1, -8, 0, 2),
		Position = UDim2.fromOffset(4, 1),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.82,
		BorderSizePixel = 0,
	}, track)
	corner(trackGloss, 1)

	-- Phần đã kéo: chất lỏng màu nhấn, đậm dần xuống dưới + vệt sáng trên
	local fill = create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.fromRGB(210, 210, 210),
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
	}, track)
	corner(fill, 4)
	Theme.track(fill, "BackgroundColor3")
	create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(WHITE, Color3.fromRGB(170, 170, 170)),
	}, fill)
	local fillGloss = create("Frame", {
		Size = UDim2.new(1, -6, 0, 2),
		Position = UDim2.fromOffset(3, 1),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
	}, fill)
	corner(fillGloss, 1)

	-- Quầng sáng sau hạt kéo
	local glow = create("Frame", {
		Size = UDim2.fromOffset(28, 28),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = Color3.fromRGB(210, 210, 210),
		BackgroundTransparency = 0.86,
		BorderSizePixel = 0,
	}, track)
	corner(glow, 14)
	Theme.track(glow, "BackgroundColor3")

	-- Hạt kéo bằng kính: có đốm phản chiếu, phồng lên khi đang kéo
	local knob = create("Frame", {
		Size = UDim2.fromOffset(18, 18),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
	}, track)
	corner(knob, 9)
	stroke(knob, 0.35, 1.2)
	local knobSpec = create("Frame", {
		Size = UDim2.fromOffset(8, 5),
		Position = UDim2.fromOffset(3, 2),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
	}, knob)
	corner(knobSpec, 3)

	local function bead(big)
		tweenEx(knob, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out, {
			Size = UDim2.fromOffset(big and 24 or 18, big and 24 or 18),
		})
		tweenEx(glow, 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {
			Size = UDim2.fromOffset(big and 42 or 28, big and 42 or 28),
			BackgroundTransparency = big and 0.78 or 0.86,
		})
	end

	local key = Persist.nextKey
	Persist.nextKey = nil
	local startVal = default
	if key then
		local saved = Persist.restore(key, default)
		if type(saved) == "number" then startVal = math.clamp(math.floor(saved + 0.5), min, max) end
	end

	local value = default
	local pending = nil
	local function setFromAlpha(alpha, silent)
		alpha = math.clamp(alpha, 0, 1)
		local v = math.floor(min + (max - min) * alpha + 0.5)
		alpha = (v - min) / (max - min)
		fill.Size = UDim2.fromScale(alpha, 1)
		knob.Position = UDim2.new(alpha, 0, 0.5, 0)
		glow.Position = UDim2.new(alpha, 0, 0.5, 0)
		valueLabel.Text = tostring(v) .. (suffix or "")
		if v ~= value then
			value = v
			if not silent then
				if key then Persist.set(key, v) end
				if onRelease then pending = v else callback(v) end
			end
		end
	end
	setFromAlpha((startVal - min) / (max - min), true)
	if startVal ~= default then
		Persist.queueApply(function() callback(startVal) end)
	end

	local sliding = false
	local trackX, trackW = 0, 1
	local scroller

	local function update(input)
		setFromAlpha((input.Position.X - trackX) / trackW)
	end

	local function finish()
		if not sliding then return end
		sliding = false
		bead(false)
		if scroller then scroller.ScrollingEnabled = true end
		if onRelease and pending ~= nil then
			local v = pending
			pending = nil
			callback(v)
		end
	end

	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			sliding = true
			bead(true)
			-- Chốt vị trí/độ rộng thanh kéo lúc bắt đầu kéo để không bị lệch khi menu đổi kích thước
			trackX, trackW = track.AbsolutePosition.X, math.max(1, track.AbsoluteSize.X)
			-- Tắt cuộn trang khi đang kéo (nếu không, kéo trên điện thoại sẽ cuộn trang)
			scroller = row:FindFirstAncestorOfClass("ScrollingFrame")
			if scroller then scroller.ScrollingEnabled = false end
			update(input)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			update(input)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			finish()
		end
	end)
	return {
		Set = function(_, v)
			setFromAlpha((v - min) / (max - min))
		end,
	}
end

-- ---------- DANH SÁCH CHỌN NGƯỜI CHƠI (có ô tìm kiếm) ----------
-- opts.onSelect(plr)     : gọi khi bấm vào một người chơi
-- opts.keepSelection     : false = chỉ là hành động (vd. dịch chuyển), không giữ dấu chọn (mặc định true)
-- opts.height            : chiều cao khung danh sách (mặc định 150)
-- Trả về { Refresh(), Set(self, plr), Get() }
local function addPlayerPicker(parent, opts)
	opts = opts or {}
	local selected = nil
	local lower, find = string.lower, string.find

	local searchBox = create("TextBox", {
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.94,
		Text = "",
		PlaceholderText = "Tìm theo tên hoặc @user...",
		PlaceholderColor3 = SUBTEXT,
		TextColor3 = TEXT,
		Font = Enum.Font.Gotham,
		TextSize = 12,
		ClearTextOnFocus = false,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, parent)
	corner(searchBox, 8)
	padding(searchBox, 0, 10, 0, 10)

	local listFrame = create("ScrollingFrame", {
		Size = UDim2.new(1, 0, 0, opts.height or 150),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.95,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = WHITE,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, parent)
	corner(listFrame, 8)
	padding(listFrame, 6, 6, 6, 6)
	create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4) }, listFrame)

	local picker = {}

	local function refresh()
		for _, c in ipairs(listFrame:GetChildren()) do
			if c:IsA("GuiObject") then c:Destroy() end
		end
		if selected and not selected.Parent then selected = nil end

		local q = lower(string.match(searchBox.Text, "^%s*(.-)%s*$") or "")
		local plist = {}
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr.Parent and (opts.includeSelf or plr ~= player) then
				if q == "" or find(lower(plr.DisplayName), q, 1, true) or find(lower(plr.Name), q, 1, true) then
					table.insert(plist, plr)
				end
			end
		end
		table.sort(plist, function(a, b) return lower(a.DisplayName) < lower(b.DisplayName) end)

		for i, plr in ipairs(plist) do
			local isSel = (plr == selected)
			local b = create("TextButton", {
				Size = UDim2.new(1, 0, 0, 30),
				BackgroundColor3 = WHITE,
				BackgroundTransparency = isSel and 0.6 or 0.92,
				Text = (isSel and "✓  " or "") .. plr.DisplayName .. "  (@" .. plr.Name .. ")",
				TextColor3 = TEXT,
				Font = Enum.Font.GothamMedium,
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				AutoButtonColor = false,
				LayoutOrder = i,
			}, listFrame)
			corner(b, 6)
			padding(b, 0, 8, 0, 8)
			if isSel then Theme.track(b, "BackgroundColor3") end
			b.MouseEnter:Connect(function()
				if plr ~= selected then tween(b, 0.12, { BackgroundTransparency = 0.82 }) end
			end)
			b.MouseLeave:Connect(function()
				if plr ~= selected then tween(b, 0.12, { BackgroundTransparency = 0.92 }) end
			end)
			b.MouseButton1Click:Connect(function()
				if opts.keepSelection ~= false then selected = plr end
				task.defer(refresh)
				if opts.onSelect then opts.onSelect(plr) end
			end)
		end

		if #plist == 0 then
			create("TextLabel", {
				Size = UDim2.new(1, 0, 0, 24),
				BackgroundTransparency = 1,
				Text = q == "" and "Chưa có người chơi khác trong server." or "Không tìm thấy người chơi nào.",
				TextColor3 = SUBTEXT,
				Font = Enum.Font.Gotham,
				TextSize = 12,
			}, listFrame)
		end
	end

	searchBox:GetPropertyChangedSignal("Text"):Connect(refresh)
	table.insert(connections, Players.PlayerAdded:Connect(function()
		task.wait(0.2)
		refresh()
	end))
	table.insert(connections, Players.PlayerRemoving:Connect(function()
		task.delay(0.1, refresh)
	end))

	picker.Refresh = refresh
	picker.Get = function() return selected end
	picker.Set = function(_, plr)
		selected = plr
		refresh()
	end
	refresh()
	return picker
end

