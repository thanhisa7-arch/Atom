		-- ===== 5. ANIMATION v2 (dùng chung cho Tốc độ v2 và Bay v2) =====
		-- Animation có sẵn lấy từ bảng ID chính thức của Roblox (create.roblox.com/docs/animation/using), dành cho R15.
		-- Chọn trong thẻ "Animation v2" của menu, hoặc dán ID khác vào ô bên dưới mỗi nút chọn.
		local ANIM_DEFAULT = { speed = "656118852", flyIdle = "74691485490268", flyMove = "73303618259519" }
		local PRESETS = {
			speed = {
				{ "Ninja — Chạy", "656118852" }, { "Flying Aura — Chạy", "73303618259519" },
