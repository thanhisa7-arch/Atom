	end

	-- ================= GLASS UI =================
	local glassCard = addCard(uiPage, "Glass UI")
	Persist.nextKey = "ui.glass"
	H.glass = addSlider(glassCard, "Độ trong suốt kính", 0, 95, 35, function(v)
		Theme.setGlass(v / 100)
	end, "%")
	Persist.nextKey = "ui.strokeLevel"
