-- Chủ đề giao diện (chỉnh trong tab UI)
local Theme = {
	accent = Color3.fromRGB(235, 235, 235),
	glass = 0.35,        -- độ trong suốt của các tấm kính
	strokeLevel = 15,    -- độ đậm viền (15 = mặc định)
	liquidBoost = 0,     -- phần sáng thêm của viền khi bật Liquid Glass
	strokes = {},
	targets = {},
	hooks = {},
	root = nil,
}

function Theme.track(inst, prop)
	table.insert(Theme.targets, { inst = inst, prop = prop })
	inst[prop] = Theme.accent
end

function Theme.refreshStrokes()
	local f = Theme.strokeLevel / 15
	for i = #Theme.strokes, 1, -1 do
		local st = Theme.strokes[i]
		if not st.Parent then
			table.remove(Theme.strokes, i)
		else
			local base = st:GetAttribute("BaseTransparency") or 0.85
			local opacity = math.min(1, (1 - base) * f + 0.35 * Theme.liquidBoost)
			st.Transparency = 1 - opacity
		end
	end
end

function Theme.apply()
	for i = #Theme.targets, 1, -1 do
		local t = Theme.targets[i]
		if t.inst.Parent then t.inst[t.prop] = Theme.accent else table.remove(Theme.targets, i) end
	end
	for i = #Theme.strokes, 1, -1 do
		local st = Theme.strokes[i]
		if st.Parent then st.Color = Theme.accent else table.remove(Theme.strokes, i) end
	end
	for _, fn in ipairs(Theme.hooks) do pcall(fn) end
end

-- Đổi màu nền kính: đổi mọi đối tượng đang dùng màu PANEL cũ
function Theme.setPanel(c)
	local old = PANEL
	if old == c then return end
	PANEL = c
	if Theme.root then
		for _, d in ipairs(Theme.root:GetDescendants()) do
			if d:IsA("GuiObject") and not d:GetAttribute("NoTheme") and d.BackgroundColor3 == old then
				d.BackgroundColor3 = c
			end
		end
	end
end

function Theme.setGlass(t)
	Theme.glass = t
	if Theme.root then
		for _, d in ipairs(Theme.root:GetDescendants()) do
			if d:IsA("GuiObject") and d:GetAttribute("Glass") then d.BackgroundTransparency = t end
		end
	end
end

