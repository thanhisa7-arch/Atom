-- ---------- Liên kết mạng xã hội ----------
-- Lưu ý: Roblox không cho script trong game tự mở trình duyệt ngoài.
-- Nên nút sẽ: thử mở bằng GuiService, sao chép link vào clipboard (nếu môi trường hỗ trợ),
-- và luôn hiện link ở ô bên dưới để bạn tự copy.
local function copyToClipboard(text)
	local fn = (typeof(setclipboard) == "function" and setclipboard)
		or (typeof(toclipboard) == "function" and toclipboard)
	if fn then
		local ok = pcall(fn, text)
		return ok
	end
	return false
end

local function openLink(name, url)
	pcall(function() GuiService:OpenBrowserWindow(url) end)
	if copyToClipboard(url) then
		notify(name, "Đã sao chép link. Dán vào trình duyệt để mở.", 4, "success")
	else
		notify(name, "Hãy copy link ở ô bên dưới rồi dán vào trình duyệt.", 4, "info")
	end
end

