		-- ================= TARGET (quay quanh người chơi) =================
		-- Công tắc "Bật Target" chỉ HIỆN nút tròn. Chọn người chơi, rồi bấm nút tròn để bắt đầu / dừng quay.
		local targetPlayer = nil
		local tgt = { on = false, speed = 40, radius = 8, height = 0, angle = 0, conn = nil, autoRotate = nil, keepCam = true, camChanged = false }
