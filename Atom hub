local function drawIcon(parent, def, size, position, color)
	local k = size / 24
	local t = math.max(1.5, 2 * k)
	local holder = create("Frame", {
		Size = UDim2.fromOffset(size, size),
		Position = position,
		BackgroundTransparency = 1,
	}, parent)
	local fills, strokes = {}, {}

	for _, l in ipairs(def.lines or {}) do
		local x1, y1, x2, y2 = l[1], l[2], l[3], l[4]
		local dx, dy = (x2 - x1) * k, (y2 - y1) * k
		local f = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy) + t, t),
			Position = UDim2.fromOffset((x1 + x2) / 2 * k, (y1 + y2) / 2 * k),
			Rotation = math.deg(math.atan2(dy, dx)),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
		}, holder)
		corner(f, t / 2)
		table.insert(fills, f)
	end

	for _, c in ipairs(def.circles or {}) do
		local d = 2 * c[3] * k - t
		local f = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(d, d),
			Position = UDim2.fromOffset(c[1] * k, c[2] * k),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
		}, holder)
		corner(f, d / 2)
		table.insert(strokes, create("UIStroke", {
			Color = color,
			Thickness = t,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}, f))
	end

	for _, d in ipairs(def.dots or {}) do
		local ds = t * 1.3
		local f = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(ds, ds),
			Position = UDim2.fromOffset(d[1] * k, d[2] * k),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
		}, holder)
		corner(f, ds / 2)
		table.insert(fills, f)
	end

	return holder, fills, strokes
end

-- names: tên icon trên lucide.dev (chuỗi hoặc danh sách tên dự phòng)
-- Trả về { Instance, SetColor(self, color) }
local function makeIcon(parent, names, fallback, size, position, color)
	if typeof(names) == "string" then names = { names } end

	if Lucide then
		for _, n in ipairs(names) do
			local ok, asset = pcall(Lucide.GetAsset, n, 48)
			if ok and asset then
				local img = create("ImageLabel", {
					Size = UDim2.fromOffset(size, size),
					Position = position,
					BackgroundTransparency = 1,
					Image = asset.Url,
					ImageRectSize = asset.ImageRectSize,
					ImageRectOffset = asset.ImageRectOffset,
					ImageColor3 = color,
				}, parent)
				return {
					Instance = img,
					SetColor = function(_, c) tween(img, 0.2, { ImageColor3 = c }) end,
				}
			end
		end
	end

	for _, n in ipairs(names) do
		local def = DRAWN[n]
		if def then
			local holder, fills, strokes = drawIcon(parent, def, size, position, color)
			return {
				Instance = holder,
				SetColor = function(_, c)
					for _, f in ipairs(fills) do tween(f, 0.2, { BackgroundColor3 = c }) end
					for _, st in ipairs(strokes) do tween(st, 0.2, { Color = c }) end
				end,
			}
		end
	end

	local label = create("TextLabel", {
		Size = UDim2.fromOffset(size, size),
		Position = position,
		BackgroundTransparency = 1,
		Text = fallback,
		TextColor3 = color,
		Font = Enum.Font.GothamBold,
		TextSize = size - 2,
	}, parent)
	return {
		Instance = label,
		SetColor = function(_, c) tween(label, 0.2, { TextColor3 = c }) end,
	}
end

