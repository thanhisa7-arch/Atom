	-- ================= TAB JJS =================
	local function buildJJS()
		-- ======= CẤU HÌNH: chỉnh nếu tên object trong game khác =======
		local HALLOWEEN_WORD = "halloween"   -- tên cửa/thư mục chứa chữ này
		local DOOR_WORD = "door"             -- tên cửa chứa chữ này
		local TIME_WORDS = { "time", "timer", "expire", "despawn", "remain", "left", "duration", "lifetime" }
		local END_KEYWORDS = { "endpoint", "end_point", "finish", "goal", "delivery" } -- điểm cuối
		-- ===============================================================

		local jjsPage = addTab("JJS", "door-closed", "🚪")

		local doors = {}         -- [instance] = true
		local extraPrompts = {}  -- [ProximityPrompt] = true (prompt có chữ "steal")
		local rows = {}          -- [door] = { frame, name, dist, time }
		local marks = {}         -- [door] = { hl, board, label }
		local timerSrc = {}      -- [door] = instance dùng để đọc thời gian
		local flags = { locator = false, marks = true, steal = false, touchEnd = true, autoFarm = false }
		local scanning = false
		local scanConns = {}
		local doorFolder = create("Folder", { Name = "AtomDoorESP" }, playerGui)
		local doorList, statusLabel

		local function lowerHas(inst, word)
			return string.find(string.lower(inst.Name), word, 1, true) ~= nil
		end

		-- ---------- Nhận diện cửa Halloween ----------
		local function isDoorCandidate(inst)
			if not (inst:IsA("Model") or inst:IsA("BasePart")) then return false end
			if not lowerHas(inst, DOOR_WORD) then return false end
			if lowerHas(inst, HALLOWEEN_WORD) then return true end
			local p = inst.Parent
			while p and p ~= workspace do
				if lowerHas(p, HALLOWEEN_WORD) then return true end
				p = p.Parent
			end
			return false
		end

		local function getDoorPart(door)
			if door:IsA("BasePart") then return door end
			return door.PrimaryPart or door:FindFirstChildWhichIsA("BasePart", true)
		end

		local function removeRow(door)
			local r = rows[door]
			if r then r.frame:Destroy() rows[door] = nil end
		end
		local function removeMark(door)
			local m = marks[door]
			if m then
				m.hl:Destroy()
				m.board:Destroy()
				marks[door] = nil
			end
		end
		local function unregisterDoor(door)
			doors[door] = nil
			timerSrc[door] = nil
			removeRow(door)
			removeMark(door)
		end
		local function registerDoor(inst)
			if doors[inst] then return end
			local p = inst.Parent
			while p and p ~= workspace do
				if doors[p] then return end -- đã có cửa cha
				p = p.Parent
			end
			for d in pairs(doors) do
				if d:IsDescendantOf(inst) then unregisterDoor(d) end
			end
			doors[inst] = true
		end

		local function scanInstance(inst)
			if inst:IsA("ProximityPrompt") then
				local t = string.lower(inst.ActionText .. " " .. inst.ObjectText)
				if string.find(t, "steal", 1, true) then extraPrompts[inst] = true end
			elseif isDoorCandidate(inst) then
				registerDoor(inst)
			end
		end

		local function scanAll(force)
			local n = 0
			for _, inst in ipairs(workspace:GetDescendants()) do
				if not force and not scanning then return end
				scanInstance(inst)
				n += 1
				if n % 1500 == 0 then task.wait() end
			end
		end

		-- ---------- Đọc thời gian còn lại ----------
		local function parseTimeText(text)
			if type(text) ~= "string" or text == "" then return nil end
			local h, m, sec = string.match(text, "(%d+):(%d+):(%d+)")
			if h then return tonumber(h) * 3600 + tonumber(m) * 60 + tonumber(sec) end
			m, sec = string.match(text, "(%d+):(%d+)")
			if m then return tonumber(m) * 60 + tonumber(sec) end
			m, sec = string.match(text, "(%d+)%s*[mM]%s*(%d+)%s*[sS]")
			if m then return tonumber(m) * 60 + tonumber(sec) end
			local n = string.match(text, "^%s*(%d+%.?%d*)%s*[sS]%s*$")
			if n then return tonumber(n) end
			return nil
		end

		local function nameHasTimeWord(name)
			local ln = string.lower(name)
			for _, w in ipairs(TIME_WORDS) do
				if string.find(ln, w, 1, true) then return true end
			end
			return false
		end

		local function attrRemaining(inst)
			for name, val in pairs(inst:GetAttributes()) do
				if type(val) == "number" and nameHasTimeWord(name) then
					if val > 1e11 then return val / 1000 - workspace:GetServerTimeNow() end
					if val > 1e9 then return val - workspace:GetServerTimeNow() end
					return val
				end
			end
			return nil
		end

		local function readRemaining(door)
			local v = attrRemaining(door)
			if v then return v end
			local part = getDoorPart(door)
			if part and part ~= door then
				v = attrRemaining(part)
				if v then return v end
			end

			local src = timerSrc[door]
			if not (src and src.Parent) then
				src = nil
				for _, d in ipairs(door:GetDescendants()) do
					if (d:IsA("NumberValue") or d:IsA("IntValue")) and nameHasTimeWord(d.Name) then
						src = d
					elseif (d:IsA("TextLabel") or d:IsA("TextBox")) and parseTimeText(d.Text) then
						src = d
					end
					if src then break end
				end
				timerSrc[door] = src
			end
			if src then
				if src:IsA("ValueBase") then return src.Value end
				return parseTimeText(src.Text)
			end
			return nil
		end

		local function formatTime(sec)
			sec = math.max(0, math.floor(sec))
			if sec >= 3600 then
				return string.format("%d:%02d:%02d", sec // 3600, (sec % 3600) // 60, sec % 60)
			end
			return string.format("%02d:%02d", sec // 60, sec % 60)
		end

		-- ---------- Danh sách + marker trên map ----------
		local function makeRow(door)
			local frame = create("Frame", {
				Size = UDim2.new(1, 0, 0, 44),
				BackgroundColor3 = WHITE,
				BackgroundTransparency = 0.94,
				BorderSizePixel = 0,
			}, doorList)
			corner(frame, 8)
			local nameLbl = create("TextLabel", {
				Size = UDim2.new(0.6, -10, 0, 20),
				Position = UDim2.fromOffset(10, 5),
				BackgroundTransparency = 1,
				Text = door.Name,
				TextColor3 = TEXT,
				Font = Enum.Font.GothamBold,
				TextSize = 13,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
			}, frame)
			local distLbl = create("TextLabel", {
				Size = UDim2.new(0.6, -10, 0, 14),
				Position = UDim2.fromOffset(10, 25),
				BackgroundTransparency = 1,
				Text = "",
				TextColor3 = SUBTEXT,
				Font = Enum.Font.Gotham,
				TextSize = 11,
				TextXAlignment = Enum.TextXAlignment.Left,
			}, frame)
			local timeLbl = create("TextLabel", {
				Size = UDim2.new(0.4, -10, 1, 0),
				Position = UDim2.fromScale(0.6, 0),
				BackgroundTransparency = 1,
				Text = "?",
				TextColor3 = TEXT,
				Font = Enum.Font.GothamBold,
				TextSize = 18,
				TextXAlignment = Enum.TextXAlignment.Right,
			}, frame)
			rows[door] = { frame = frame, name = nameLbl, dist = distLbl, time = timeLbl }
			return rows[door]
		end

		local function ensureMark(door, part)
			local m = marks[door]
			if m and m.board.Parent then return m end
			removeMark(door)
			local hl = create("Highlight", {
				Adornee = door,
				FillColor = Color3.fromRGB(255, 150, 40),
				OutlineColor = Color3.fromRGB(255, 210, 130),
				FillTransparency = 0.6,
				DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
			}, doorFolder)
			local board = create("BillboardGui", {
				Adornee = part,
				AlwaysOnTop = true,
				Size = UDim2.fromOffset(200, 40),
				StudsOffset = Vector3.new(0, 3, 0),
			}, doorFolder)
			local label = create("TextLabel", {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Text = "",
				TextColor3 = Color3.fromRGB(255, 210, 130),
				TextStrokeTransparency = 0.4,
				Font = Enum.Font.GothamBold,
				TextSize = 13,
			}, board)
			marks[door] = { hl = hl, board = board, label = label }
			return marks[door]
		end

		local function updateDoors()
			local root = getRoot()
			local count = 0
			for door in pairs(doors) do
				if not door.Parent then
					unregisterDoor(door)
				else
					count += 1
					local part = getDoorPart(door)
					local dist = (root and part) and math.floor((root.Position - part.Position).Magnitude) or nil
					local remaining = readRemaining(door)
					local timeText = remaining and formatTime(remaining) or "?"

					local row = rows[door] or makeRow(door)
					row.name.Text = door.Name
					row.dist.Text = dist and (dist .. " studs") or ""
					row.time.Text = timeText
					row.time.TextColor3 = (remaining and remaining <= 10) and Color3.fromRGB(230, 90, 90) or TEXT
					row.frame.LayoutOrder = dist or 9999

					if flags.marks and part then
						local m = ensureMark(door, part)
						m.label.Text = "Cửa Halloween  " .. timeText .. (dist and ("  [" .. dist .. "m]") or "")
					else
						removeMark(door)
					end
				end
			end
			if statusLabel then
				statusLabel.Text = count > 0 and ("Tìm thấy " .. count .. " cửa.")
					or "Chưa thấy cửa Halloween nào (có thể chưa xuất hiện, hoặc tên khác — bấm Chẩn đoán)."
			end
		end

		-- ---------- Steal Door Fast ----------
		local origHold, hooked = {}, {}
		local endCache, endCacheAt = {}, -100
		local lastWarn = 0

		local function refreshEndParts(force)
			if not force and os.clock() - endCacheAt < 10 then return end
			endCacheAt = os.clock()
			endCache = {}
			local n = 0
			for _, d in ipairs(workspace:GetDescendants()) do
				if d:IsA("BasePart") then
					local ln = string.lower(d.Name)
					for _, w in ipairs(END_KEYWORDS) do
						if string.find(ln, w, 1, true) then
							table.insert(endCache, d)
							break
						end
					end
				end
				n += 1
				if n % 2000 == 0 then task.wait() end
			end
		end

		local function warnOnce(msg)
			if os.clock() - lastWarn > 5 then
				lastWarn = os.clock()
				notify("Steal Door", msg, 4, "warn")
			end
		end

		-- Chạm điểm cuối bằng firetouchinterest (KHÔNG dịch chuyển nhân vật)
		local function touchEnd(prompt)
			local fire = typeof(firetouchinterest) == "function" and firetouchinterest or nil
			local root = getRoot()
			if not fire or not root then
				warnOnce("Môi trường không hỗ trợ firetouchinterest nên chỉ bỏ qua được thời gian nhấn.")
				return
			end
			refreshEndParts(false)
			local origin
			local par = prompt.Parent
			if par and par:IsA("BasePart") then origin = par.Position
			elseif par and par:IsA("Attachment") then origin = par.WorldPosition end

			local best, bestDist
			for _, part in ipairs(endCache) do
				if part.Parent then
					local d = origin and (part.Position - origin).Magnitude or 0
					if not bestDist or d < bestDist then best, bestDist = part, d end
				end
			end
			if not best then
				warnOnce("Không tìm thấy điểm cuối. Bấm Chẩn đoán hoặc chỉnh END_KEYWORDS.")
				return
			end
			pcall(function()
				fire(root, best, 0)
				task.wait(0.05)
				fire(root, best, 1)
			end)
			notify("Steal Door", "Đã chạm điểm cuối.", 2, "success")
		end

		local function collectPrompts()
			local list = {}
			for door in pairs(doors) do
				if door.Parent then
					for _, d in ipairs(door:GetDescendants()) do
						if d:IsA("ProximityPrompt") then list[d] = true end
					end
				end
			end
			for pr in pairs(extraPrompts) do
				if pr.Parent then list[pr] = true end
			end
			return list
		end

		local function applySteal()
			for pr in pairs(collectPrompts()) do
				if origHold[pr] == nil then origHold[pr] = pr.HoldDuration end
				if pr.HoldDuration ~= 0 then pr.HoldDuration = 0 end
				if not hooked[pr] then
					hooked[pr] = pr.Triggered:Connect(function(plr)
						if plr == player and flags.touchEnd then touchEnd(pr) end
					end)
				end
			end
		end

		local function restoreSteal()
			for pr, orig in pairs(origHold) do
				if pr.Parent then pr.HoldDuration = orig end
			end
			origHold = {}
			for _, c in pairs(hooked) do c:Disconnect() end
			hooked = {}
		end

		local refreshScan -- khai báo trước (định nghĩa ở phần Quản lý quét bên dưới)

		-- ---------- Auto Farm ----------
		local PathfindingService = game:GetService("PathfindingService")
		local farmSpeed = 80
		local idleSpot = nil
		local idleTeleport = true
		local farmRunning = false
		local lastDoorAt = -100 -- lần cuối còn thấy cửa (để không bỏ về vị trí chờ quá vội)
		local farmStatus

		local function setFarmStatus(t)
			if farmStatus then farmStatus.Text = "Trạng thái bot: " .. t end
		end

		-- Kích hoạt prompt ngay lập tức
		local function triggerPrompt(pr)
			if typeof(fireproximityprompt) == "function" then
				pcall(fireproximityprompt, pr)
			else
				pcall(function()
					pr:InputHoldBegin()
					task.wait(0.05)
					pr:InputHoldEnd()
				end)
			end
		end

		-- Chọn cửa gần nhất còn lấy được
		local function pickDoor(root, blacklist)
			if not root then return nil end
			local now = os.clock()
			local bestDoor, bestPr, bestPart, bestDist
			for door in pairs(doors) do
				if door.Parent and (blacklist[door] or 0) < now then
					local rem = readRemaining(door)
					local part = getDoorPart(door)
					if part and (rem == nil or rem > 2) then
						local pr
						for _, d in ipairs(door:GetDescendants()) do
							if d:IsA("ProximityPrompt") and d.Enabled then
								pr = d
								break
							end
						end
						if pr then
							local dist = (part.Position - root.Position).Magnitude
							if not bestDist or dist < bestDist then
								bestDoor, bestPr, bestPart, bestDist = door, pr, part, dist
							end
						else
							blacklist[door] = now + 5
						end
					end
				end
			end
			return bestDoor, bestPr, bestPart
		end

		-- Đi bộ tới vị trí (Pathfinding, có nhảy). abortIf: hàm trả true thì dừng sớm.
		local function walkTo(targetPos, stopDist, timeout, abortIf)
			local hum, root = getHumanoid(), getRoot()
			if not hum or not root then return false end
			local t0 = os.clock()
			local function near() return (root.Position - targetPos).Magnitude <= stopDist end

			local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })
			local ok = pcall(function() path:ComputeAsync(root.Position, targetPos) end)

			if ok and path.Status == Enum.PathStatus.Success then
				for _, wp in ipairs(path:GetWaypoints()) do
					if not flags.autoFarm or near() then break end
					if abortIf and abortIf() then return false end
					if os.clock() - t0 > timeout then return false end
					if wp.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
					hum:MoveTo(wp.Position)
					local t1 = os.clock()
					while flags.autoFarm and os.clock() - t1 < 1.5
						and (root.Position - wp.Position).Magnitude > math.max(3.5, farmSpeed * 0.05) and not near() do
						task.wait(0.05)
					end
				end
			else
				-- Không tìm được đường: đi thẳng
				hum:MoveTo(targetPos)
				while flags.autoFarm and not near() and os.clock() - t0 < timeout do
					if abortIf and abortIf() then return false end
					task.wait(0.1)
				end
			end
			return near()
		end

		-- Cửa đã lấy xong chưa? (cửa biến mất, hoặc prompt bị tắt/xoá)
		local function doorTaken(door, pr)
			return not door.Parent or not doors[door] or not pr.Parent or not pr.Enabled
		end

		local function farmStep(blacklist)
			local hum, root = getHumanoid(), getRoot()
			if not hum or not root or hum.Health <= 0 then
				setFarmStatus("chờ nhân vật hồi sinh...")
				task.wait(1)
				return
			end
			F.farming = true
			hum.WalkSpeed = farmSpeed

			local door, pr, part = pickDoor(root, blacklist)
			if door then
				lastDoorAt = os.clock()
				setFarmStatus("đi tới " .. door.Name)
				local stopDist = math.max(3, math.min(pr.MaxActivationDistance - 2, 10))
				local gone = function() return doorTaken(door, pr) end
				local arrived = walkTo(part.Position, stopDist, 25, gone)
				local taken = false
				if arrived and flags.autoFarm then
					setFarmStatus("đang lấy " .. door.Name)
					if origHold[pr] == nil then origHold[pr] = pr.HoldDuration end
					pcall(function() pr.RequiresLineOfSight = false end)

					-- Thử tối đa 5 lần, KIỂM TRA đã lấy xong chưa rồi mới đi tiếp
					for attempt = 1, 5 do
						if not flags.autoFarm or gone() then break end
						local r = getRoot()
						if not r or not part.Parent then break end
						-- Lỡ bị đẩy ra xa thì đi sát lại cửa
						if (r.Position - part.Position).Magnitude > stopDist + 2 then
							walkTo(part.Position, stopDist, 6, gone)
						end
						if attempt <= 2 then
							-- Cách nhanh: bỏ qua thời gian nhấn
							pr.HoldDuration = 0
							triggerPrompt(pr)
						else
							-- Dự phòng: server có thể kiểm tra thời gian giữ -> giữ đúng thời gian thật
							local hd = math.max(origHold[pr] or 1, 0.1)
							setFarmStatus("đang giữ để lấy " .. door.Name)
							pr.HoldDuration = hd
							pcall(function() pr:InputHoldBegin() end)
							task.wait(hd + 0.25)
							pcall(function() pr:InputHoldEnd() end)
						end
						task.wait(0.3)
						if flags.touchEnd then touchEnd(pr) end
						task.wait(0.25)
						if gone() then break end
					end
					taken = gone()
				end
				-- Lấy được: cửa thường tự biến mất. Chưa lấy được: thử lại sau 6 giây
				blacklist[door] = os.clock() + (taken and 20 or (arrived and 6 or 8))
				setFarmStatus(taken and ("đã lấy " .. door.Name) or ("chưa lấy được " .. door.Name .. ", thử cửa khác"))
			else
				-- Vừa mới hết cửa: chờ vài giây xem cửa mới/cửa còn lại có hiện không rồi mới về vị trí chờ
				if os.clock() - lastDoorAt < 3 then
					setFarmStatus("chờ cửa tiếp theo...")
					task.wait(0.3)
					return
				end
				setFarmStatus("không thấy cửa — đứng chờ")
				if idleSpot and (root.Position - idleSpot).Magnitude > 6 then
					local reached = walkTo(idleSpot, 5, 15, function()
						return pickDoor(getRoot(), blacklist) ~= nil
					end)
					if not reached and idleTeleport and flags.autoFarm
						and pickDoor(getRoot(), blacklist) == nil then
						root.CFrame = CFrame.new(idleSpot + Vector3.new(0, 3, 0))
					end
				end
				task.wait(0.4)
			end
		end

		local function stopFarmCleanup()
			F.farming = false
			local hum, root = getHumanoid(), getRoot()
			if hum then
				if root then hum:MoveTo(root.Position) end
				hum.WalkSpeed = (F.speed ~= DEFAULT_SPEED) and F.speed or DEFAULT_SPEED
			end
			if not flags.steal then restoreSteal() end
		end

		local function setAutoFarm(on)
			flags.autoFarm = on
			refreshScan()
			if on then
				if handles.fly then handles.fly:Set(false) end
				if farmRunning then return end
				farmRunning = true
				task.spawn(function()
					local blacklist = {}
					while flags.autoFarm do
						local ok, err = pcall(farmStep, blacklist)
						if not ok then
							warn("[Atom] AutoFarm: " .. tostring(err))
							task.wait(1)
						end
						task.wait()
					end
					farmRunning = false
					stopFarmCleanup()
					setFarmStatus("tắt")
				end)
			end
		end

