			},
		}
		local ANIM_KEYS = { speed = "secret.animSpeed", flyIdle = "secret.animFlyIdle", flyMove = "secret.animFlyMove" }
		local anim = {}
		for k, def in pairs(ANIM_DEFAULT) do
			local saved = Persist.restore(ANIM_KEYS[k], nil)
			if type(saved) == "string" and (saved == "" or string.match(saved, "^%d+$")) then
				anim[k] = saved
			else
				anim[k] = def
			end
		end

		local cache = { hum = nil, tracks = {} }
		local warned = {}

		local function getTrack(kind)
			local id = anim[kind]
			if not id or id == "" then return nil end
			local hum = myHum()
			if not hum then return nil end
			if cache.hum ~= hum then cache = { hum = hum, tracks = {} } end
			local key = kind .. ":" .. id
			local tr = cache.tracks[key]
			if tr == nil then
				local animator = hum:FindFirstChildOfClass("Animator") or create("Animator", {}, hum)
				local a = create("Animation", { AnimationId = "rbxassetid://" .. id }, nil)
				local ok, res = pcall(function() return animator:LoadAnimation(a) end)
				if ok and res then
					res.Looped = true
					res.Priority = Enum.AnimationPriority.Action4
					tr = res
					task.delay(2.5, function()
						if tr.Length == 0 and not warned[key] then
							warned[key] = true
							notify("Animation", "Animation không tải được (ID sai, hoặc không phải animation của Roblox/chủ game).", 4, "warn", true)
						end
					end)
				else
					tr = false
				end
				cache.tracks[key] = tr
			end
			return tr or nil
		end

		local function stopAllAnims()
			for _, t in pairs(cache.tracks) do
				if t and t.IsPlaying then t:Stop(0.2) end
			end
		end
		local function resetAnims()
			stopAllAnims()
			cache = { hum = nil, tracks = {} }
			warned = {}
		end
		-- Chỉ phát track này, dừng các track khác
		local function playOnly(tr, speed)
			for _, t in pairs(cache.tracks) do
				if t and t ~= tr and t.IsPlaying then t:Stop(0.2) end
			end
			if tr then
				if not tr.IsPlaying then tr:Play(0.2) end
				if speed then tr:AdjustSpeed(speed) end
