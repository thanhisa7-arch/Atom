	end, "%")

	gui.Destroying:Connect(function()
		if blur then blur:Destroy() end
		if L.conn then L.conn:Disconnect() end
	end)

	-- ================= GHI NHỚ CÀI ĐẶT =================
	local saveCard = addCard(uiPage, "Ghi nhớ cài đặt")
	addToggle(saveCard, "Tự bật lại cài đặt khi vào game", Persist.get("_auto", true), function(on)
		Persist.set("_auto", on)
	end)
	local modeText = ({
		file = "Nơi lưu: tệp trên máy (writefile) — nhớ được cả những lần chơi sau.",
		server = "Nơi lưu: server của game (DataStore) — nhớ được cả những lần chơi sau.",
		session = "Nơi lưu: chỉ trong phiên hiện tại. Môi trường này không hỗ trợ lưu lâu dài (cần writefile hoặc server script AtomSettingsServer).",
	})[Persist.mode]
	addText(saveCard, modeText)
	addButton(saveCard, "Lưu ngay", function()
		Persist.flush()
		notify("Ghi nhớ", "Đã lưu cài đặt.", 2, "success")
	end)
	addButton(saveCard, "Xoá dữ liệu đã lưu", function()
		Persist.clear()
		notify("Ghi nhớ", "Đã xoá. Lần sau menu sẽ về mặc định.", 3, "warn")
	end)
	addButton(saveCard, "Đặt lại giao diện mặc định", function()
		H.r:Set(235)
		H.g:Set(235)
		H.b:Set(235)
		setPanelRGB(8, 8, 8, false)
		Persist.set("ui.panel", nil)
		H.glass:Set(35)
		H.stroke:Set(15)
		H.blur:Set(false)
		H.blurSize:Set(14)
		H.liquid:Set(false)
		H.liquidI:Set(60)
		H.liquidS:Set(40)
		notify("Giao diện", "Đã đặt lại giao diện mặc định.", 2, "success")
	end)
end

