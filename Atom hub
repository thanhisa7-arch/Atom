local function playIntro()
	local introGui = create("ScreenGui", {
		Name = "AtomIntroGui",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 1000,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, playerGui)

	-- Nền tối (chặn bấm xuyên qua trong lúc intro)
	local backdrop = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = true,
	}, introGui)
	tweenEx(backdrop, 0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { BackgroundTransparency = 0.05 })

	-- Khung giữa màn hình
	local holder = create("CanvasGroup", {
		Size = UDim2.fromOffset(320, 290),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundTransparency = 1,
	}, introGui)
	local sz = gui.AbsoluteSize
	local introFit = (sz.X > 0 and sz.Y > 0) and math.clamp(math.min(sz.X / 360, sz.Y / 330), 0.5, 1) or 1
	local holderScale = create("UIScale", { Scale = introFit }, holder)

	-- Logo
	local logoBox = create("CanvasGroup", {
		Size = UDim2.fromOffset(150, 150),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Rotation = -70,
	}, holder)
	fillWithLogo(logoBox, 150)
	local logoScale = create("UIScale", { Scale = 0.4 }, logoBox)

	tweenEx(logoBox, 0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { GroupTransparency = 0 })
	tweenEx(logoBox, 1.0, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, { Rotation = 0 })
	tweenEx(logoScale, 0.8, Enum.EasingStyle.Back, Enum.EasingDirection.Out, { Scale = 1 })

	-- Tên menu: hiện từng chữ
	local titleRow = create("Frame", {
		Size = UDim2.new(1, 0, 0, 46),
		Position = UDim2.fromOffset(0, 180),
		BackgroundTransparency = 1,
	}, holder)
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
	}, titleRow)

	local letters = {}
	for _, cp in utf8.codes(MENU_TITLE) do
		local l = create("TextLabel", {
			Size = UDim2.fromOffset(34, 44),
			BackgroundTransparency = 1,
			Text = utf8.char(cp),
			TextColor3 = TEXT,
			Font = Enum.Font.GothamBlack,
			TextSize = 38,
			TextTransparency = 1,
			LayoutOrder = #letters + 1,
		}, titleRow)
		table.insert(letters, l)
	end

	local byline = create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.fromOffset(0, 230),
		BackgroundTransparency = 1,
		Text = "by " .. AUTHOR,
		TextColor3 = SUBTEXT,
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextTransparency = 1,
	}, holder)

	-- Thanh tiến trình
	local barTrack = create("Frame", {
		Size = UDim2.fromOffset(160, 3),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 266),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.85,
		BorderSizePixel = 0,
	}, holder)
	corner(barTrack, 2)
	local barFill = create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
	}, barTrack)
	corner(barFill, 2)

	task.wait(0.45)
	TweenService:Create(barFill, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
		Size = UDim2.fromScale(1, 1),
	}):Play()

	for _, l in ipairs(letters) do
		tweenEx(l, 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { TextTransparency = 0 })
		task.wait(0.1)
	end
	tweenEx(byline, 0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { TextTransparency = 0 })

	task.wait(1.3)

	-- Thoát intro
	tweenEx(holder, 0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.In, { GroupTransparency = 1 })
	tweenEx(holderScale, 0.45, Enum.EasingStyle.Back, Enum.EasingDirection.In, { Scale = introFit * 1.25 })
	tweenEx(backdrop, 0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In, { BackgroundTransparency = 1 })
	task.wait(0.55)
	introGui:Destroy()
end

