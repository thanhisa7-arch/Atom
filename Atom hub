		Text = name,
		TextColor3 = SUBTEXT,
		Font = Enum.Font.GothamMedium,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, button)

	-- Mỗi trang nằm trong một CanvasGroup để fade/trượt cả trang
	local group = create("CanvasGroup", {
		Name = name .. "Group",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Visible = false,
	}, content)

	local page = create("ScrollingFrame", {
		Name = name .. "Page",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = WHITE,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, group)
	create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 10) }, page)
	padding(page, 0, 6, 0, 0)

	button.MouseEnter:Connect(function()
		if currentTab ~= name then tween(button, 0.15, { BackgroundTransparency = 0.94 }) end
	end)
	button.MouseLeave:Connect(function()
		if currentTab ~= name then tween(button, 0.15, { BackgroundTransparency = 1 }) end
	end)
	button.MouseButton1Click:Connect(function() selectTab(name) end)

	tabs[name] = { button = button, label = label, icon = iconInst, page = page, group = group, index = tabCount }
	return page
end

