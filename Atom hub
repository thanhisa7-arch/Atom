-- ---------- Hệ thống tab ----------
local tabs = {}
local currentTab
local tabCount = 0
local tabToken = 0

local function selectTab(name)
	local new = tabs[name]
	if not new or currentTab == name then return end
	local old = currentTab and tabs[currentTab]
	currentTab = name
	tabToken += 1
	local token = tabToken
	local dir = (old and new.index < old.index) and -1 or 1 -- hướng trượt theo thứ tự tab

	-- Màu chữ + icon của tab
	for tabName, t in pairs(tabs) do
		local active = (tabName == name)
		tween(t.label, 0.2, { TextColor3 = active and TEXT or SUBTEXT })
		t.icon:SetColor(active and TEXT or SUBTEXT)
		if active then tween(t.button, 0.15, { BackgroundTransparency = 1 }) end
	end

	-- Highlight trượt tới tab mới
	local y = (new.index - 1) * TAB_PITCH
	-- Tự cuộn danh sách tab để tab đang chọn luôn nằm trong khung nhìn
	do
		local viewH = tabScroll.AbsoluteSize.Y
		local cy = tabScroll.CanvasPosition.Y
		if y < cy then
			tabScroll.CanvasPosition = Vector2.new(0, y)
		elseif y + TAB_H > cy + viewH then
			tabScroll.CanvasPosition = Vector2.new(0, y + TAB_H - viewH)
		end
	end
	if old then
		tweenEx(highlight, 0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out, {
			Position = UDim2.fromOffset(0, y),
		})
	else
		highlight.Position = UDim2.fromOffset(0, y)
		highlight.Visible = true
	end

	-- Ẩn các trang không liên quan (tránh chặn chuột khi bấm tab liên tục)
	for _, t in pairs(tabs) do
		if t ~= new and t ~= old then
			t.group.Visible = false
			t.group.GroupTransparency = 1
		end
	end

	if old then
		-- Trang cũ: mờ dần + trượt đi
		tweenEx(old.group, 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {
			GroupTransparency = 1,
			Position = UDim2.fromOffset(0, -16 * dir),
		})
		task.delay(0.2, function()
			if tabToken == token then old.group.Visible = false end
		end)

		-- Trang mới: hiện dần + trượt vào
		new.page.CanvasPosition = Vector2.zero
		new.group.Position = UDim2.fromOffset(0, 18 * dir)
		new.group.GroupTransparency = 1
		new.group.Visible = true
		task.delay(0.08, function()
			if tabToken == token then
				tweenEx(new.group, 0.38, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, {
					GroupTransparency = 0,
					Position = UDim2.fromOffset(0, 0),
				})
			end
		end)

		-- Tiêu đề: mờ đi rồi hiện tên mới
		tween(pageTitle, 0.1, { TextTransparency = 1 })
		task.delay(0.1, function()
			if tabToken == token then
				pageTitle.Text = name
				tween(pageTitle, 0.25, { TextTransparency = 0 })
			end
		end)
	else
		-- Lần chọn đầu tiên: không cần animation (menu đang chạy hiệu ứng mở)
		new.group.Position = UDim2.fromOffset(0, 0)
		new.group.GroupTransparency = 0
		new.group.Visible = true
		pageTitle.Text = name
	end
end

