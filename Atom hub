-- ---------- Ẩn/hiện, đóng ----------
local baseScale = 1            -- kích thước menu (chỉnh trong Settings)
local menuTransparency = 0     -- độ trong suốt menu (chỉnh trong Settings)

-- Tự co giãn menu theo kích thước màn hình (menu gốc 640x400, chừa lề 24px)
local MENU_W, MENU_H, MENU_MARGIN = 640, 470, 24
local function targetScale()
	local size = gui.AbsoluteSize
	if size.X <= 0 or size.Y <= 0 then return baseScale end
	local fit = math.min((size.X - MENU_MARGIN) / MENU_W, (size.Y - MENU_MARGIN) / MENU_H)
	local auto = math.clamp(fit, 0.45, 1.25)
	-- Nhân với tuỳ chọn "Kích thước menu", nhưng không bao giờ lớn hơn màn hình
	return math.max(0.3, math.min(auto * baseScale, fit))
end
local visible = true
local visToken = 0
local function setVisible(v)
	visible = v
	Theme.glassActive = v
	visToken += 1
	local token = visToken
	if Theme.onVisibility then Theme.onVisibility(v) end

	-- Nút nổi luôn hiện rõ; chỉ đổi độ sáng viền để báo menu đang ẩn hay hiện
	floatBtn.Visible = SETTINGS.floatButton
	tween(floatStroke, 0.2, { Transparency = v and 0.55 or 0.1 })

	if v then
		main.Visible = true
		tweenEx(main, 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { GroupTransparency = menuTransparency })
		tweenEx(scale, 0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out, { Scale = targetScale() })
	else
		tweenEx(main, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In, { GroupTransparency = 1 })
		tweenEx(scale, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In, { Scale = targetScale() * 0.88 })
		task.delay(0.22, function()
			if visToken == token then main.Visible = false end
		end)
	end
end


