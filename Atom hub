		-- ================= LOCK-ON (khoá mục tiêu kiểu nút bấm) =================
		-- Hoạt động giống script lock-on mẫu:
		--   • Bấm nút tròn: khoá mục tiêu NẰM GẦN TÂM MÀN HÌNH nhất (người chơi + NPC). Bấm lần nữa để nhả.
		--   • Nếu bạn đã chọn 1 người trong danh sách thì khoá đúng người đó.
		--   • Khi khoá: dấu đỏ trên mục tiêu (nhỏ dần khi ở xa), nhân vật quay mặt về mục tiêu,
		--     camera chuyển sang góc nhìn sau lưng nhân vật và bám mục tiêu.
		--   • Tự nhả khi: mục tiêu chết/biến mất, mục tiêu quá xa, hoặc bạn chết.
		--   • Nút tròn nhấp nháy: ĐỎ = chưa khoá, XANH LÁ = đang khoá.
		-- Chỉ xoay camera và hướng nhân vật, KHÔNG tự đánh hay tự bắn.
		local AIM_MARKER_IMAGE = "" -- (tuỳ chọn) dán "rbxassetid://ID" ảnh dấu khoá; để trống = dùng hình thoi đỏ tự vẽ

		local aim = {
			on = false,
			smooth = 35,       -- độ mượt camera (35 = 0.35 như script mẫu)
			maxDist = 500,
			wall = false, team = false, npc = true,
			face = true, cam = true, camBack = 12, camUp = 6,
			partIdx = 1,
			chosen = nil,      -- người chọn sẵn từ danh sách (Player)
			target = nil,      -- { model, hum, player }
		}
		local AIM_PARTS = {
			{ label = "Thân", names = { "HumanoidRootPart", "UpperTorso", "Torso" } },
			{ label = "Đầu", names = { "Head" } },
		}
		local aimLocked = false
		local aimRb, aimStatus, aimChosenLabel, aimPicker
		local stopAim -- khai báo trước

		do
			local savedIdx = Persist.restore("jjs.aimPart2", nil)
			if type(savedIdx) == "number" and AIM_PARTS[savedIdx] then aim.partIdx = savedIdx end
		end

		local function setAimStatus(t)
			if aimStatus then aimStatus.Text = t end
		end

		local function setChosenLabel()
			if aimChosenLabel then
				aimChosenLabel.Text = aim.chosen
					and ("Người đã chọn: " .. aim.chosen.DisplayName .. " (@" .. aim.chosen.Name .. ")")
					or "Người đã chọn: chưa chọn (bấm nút sẽ khoá mục tiêu gần tâm màn hình)"
			end
		end

		-- ----- Danh sách NPC (Model có Humanoid, không phải người chơi) -----
		local npcSet, npcStarted = {}, false
		local function registerNPC(model)
			if not model or not model:IsA("Model") then return end
			if model == player.Character or Players:GetPlayerFromCharacter(model) then return end
			if model:FindFirstChildOfClass("Humanoid")
				and (model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
					or model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")) then
				npcSet[model] = true
			end
		end
		local function startNPC()
			if npcStarted then return end
			npcStarted = true
			task.spawn(function()
				local n = 0
				for _, o in ipairs(workspace:GetDescendants()) do
					if o:IsA("Model") then registerNPC(o) end
					n += 1
					if n % 2000 == 0 then task.wait() end
				end
			end)
			table.insert(connections, workspace.DescendantAdded:Connect(function(o)
				if o:IsA("Model") then
					task.defer(registerNPC, o)
				elseif o:IsA("Humanoid") or o.Name == "HumanoidRootPart" or o.Name == "UpperTorso" or o.Name == "Torso" then
					local m = o:FindFirstAncestorOfClass("Model")
					if m then task.defer(registerNPC, m) end
				end
			end))
			table.insert(connections, workspace.DescendantRemoving:Connect(function(o) npcSet[o] = nil end))
		end
		if aim.npc then startNPC() end

		-- ----- Kiểm tra / chọn mục tiêu -----
		local rayParams = RaycastParams.new()
		rayParams.FilterType = Enum.RaycastFilterType.Exclude

		local function modelPart(model)
			for _, n in ipairs(AIM_PARTS[aim.partIdx].names) do
				local p = model:FindFirstChild(n)
				if p and p:IsA("BasePart") then return p end
			end
			if model.PrimaryPart then return model.PrimaryPart end
			return nil
		end

		local function checkModel(model)
			if not model or not model:IsA("Model") or model == player.Character then return nil end
			local hum = model:FindFirstChildOfClass("Humanoid")
			if not hum or hum.Health <= 0 then return nil end
			local part = modelPart(model)
			if not part then return nil end
			return part, hum
		end

		local function clearLine(cam, part, model)
			rayParams.FilterDescendantsInstances = { player.Character, model }
			local origin = cam.CFrame.Position
			return workspace:Raycast(origin, part.Position - origin, rayParams) == nil
		end

		local function targetName(ent)
			return ent.player and ent.player.DisplayName or ent.model.Name
		end

		-- Mục tiêu gần tâm màn hình nhất (người chơi + NPC), trong tầm và đang hiện trên màn hình
		local function getClosest()
			local cam = workspace.CurrentCamera
			local myRoot = getRoot()
			if not cam or not myRoot then return nil end
			local center = cam.ViewportSize / 2
			local best, bestD
			local function consider(model, plr)
				local part, hum = checkModel(model)
				if not part then return end
				if (part.Position - myRoot.Position).Magnitude > aim.maxDist then return end
				local v, onScreen = cam:WorldToViewportPoint(part.Position)
				if not onScreen then return end
				local d = (Vector2.new(v.X, v.Y) - center).Magnitude
				if bestD and d >= bestD then return end
				if aim.wall and not clearLine(cam, part, model) then return end
				best, bestD = { model = model, hum = hum, player = plr }, d
			end
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= player and plr.Character
					and not (aim.team and plr.Team ~= nil and plr.Team == player.Team) then
					consider(plr.Character, plr)
				end
			end
			if aim.npc then
				for model in pairs(npcSet) do
					if model.Parent and not Players:GetPlayerFromCharacter(model) then consider(model, nil) end
				end
			end
			return best
		end

		local function entityOf(plr)
			local ch = plr and plr.Character
			local part, hum = checkModel(ch)
			if part then return { model = ch, hum = hum, player = plr } end
			return nil
		end

		-- ----- Dấu lock-on trên mục tiêu -----
		local lockFolder = create("Folder", { Name = "AtomLockOn" }, playerGui)
		gui.Destroying:Connect(function() lockFolder:Destroy() end)
		local marker, savedAutoRotate, camChanged = nil, nil, false
		local LOCK_RED = Color3.fromRGB(255, 70, 70)

		local function clearMarker()
			if marker then
				marker.board:Destroy()
				marker = nil
			end
		end

		local function restoreRotate()
			if savedAutoRotate ~= nil then
				local hum = getHumanoid()
				if hum then hum.AutoRotate = savedAutoRotate end
				savedAutoRotate = nil
			end
		end

		local function restoreCamera()
			if camChanged then
				camChanged = false
				local cam, hum = workspace.CurrentCamera, getHumanoid()
				if cam then
					cam.CameraType = Enum.CameraType.Custom
					if hum then cam.CameraSubject = hum end
				end
			end
		end

		local function ensureMarker(part)
			if marker and marker.board.Parent then
				if marker.board.Adornee ~= part then marker.board.Adornee = part end
				return marker
			end
			clearMarker()
			local board = create("BillboardGui", {
				Adornee = part,
				AlwaysOnTop = true,
				Size = UDim2.fromOffset(90, 90),
				StudsOffsetWorldSpace = Vector3.new(0, 0.2, 0),
				MaxDistance = aim.maxDist + 50,
			}, lockFolder)
			if AIM_MARKER_IMAGE ~= "" and AIM_MARKER_IMAGE ~= "rbxassetid://0" then
				create("ImageLabel", {
					Size = UDim2.fromScale(1, 1),
					BackgroundTransparency = 1,
					Image = AIM_MARKER_IMAGE,
					ScaleType = Enum.ScaleType.Fit,
				}, board)
			else
				local ring = create("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromScale(0.5, 0.5),
					Size = UDim2.fromScale(0.5, 0.5),
					BackgroundTransparency = 1,
					Rotation = 45,
				}, board)
				create("UIStroke", { Color = LOCK_RED, Thickness = 2.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, ring)
				local dot = create("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromScale(0.5, 0.5),
					Size = UDim2.fromOffset(6, 6),
					BackgroundColor3 = LOCK_RED,
					BorderSizePixel = 0,
				}, board)
				corner(dot, 3)
			end
			local label = create("TextLabel", {
				Size = UDim2.fromOffset(180, 16),
				Position = UDim2.new(0.5, -90, 1, 0),
				BackgroundTransparency = 1,
				Text = "",
				TextColor3 = LOCK_RED,
				TextStrokeTransparency = 0.4,
				Font = Enum.Font.GothamBold,
				TextSize = 13,
			}, board)
			marker = { board = board, label = label }
			return marker
		end

		-- ----- Vòng lặp khoá (mỗi khung hình) -----
		local function aimStep(dt)
			local cam = workspace.CurrentCamera
			if not cam then return end
			local ent = aim.target
			if not ent or not ent.model.Parent or ent.hum.Health <= 0 then
				notify("Lock-on", "Mục tiêu đã mất hoặc đã chết — đã nhả khoá.", 2, "info")
				stopAim()
				return
			end
			local myRoot, myHum = getRoot(), getHumanoid()
			if not myRoot or not myHum or myHum.Health <= 0 then
				stopAim()
				return
			end
			local part = modelPart(ent.model)
			if not part then
				stopAim()
				return
			end
			local dist = (part.Position - myRoot.Position).Magnitude
			if dist > aim.maxDist then
				notify("Lock-on", "Mục tiêu ra xa quá — đã nhả khoá.", 2, "warn")
				stopAim()
				return
			end

			-- Dấu khoá: nhỏ dần khi ở xa (140 -> 70 như script mẫu)
			local mk = ensureMarker(part)
			local sz = math.clamp(140 - dist * 0.14, 70, 140) * 0.75
			mk.board.Size = UDim2.fromOffset(sz, sz)
			mk.label.Text = targetName(ent) .. "  [" .. math.floor(dist) .. "m]"

			-- Nhân vật quay mặt về mục tiêu (nhường khi đang bay / Target / Auto Farm)
			local flat = Vector3.new(part.Position.X, myRoot.Position.Y, part.Position.Z)
			if aim.face and not F.fly and not tgt.on and not F.farming then
				if savedAutoRotate == nil then savedAutoRotate = myHum.AutoRotate end
				myHum.AutoRotate = false
				if (flat - myRoot.Position).Magnitude > 0.5 then
					myRoot.CFrame = CFrame.lookAt(myRoot.Position, flat)
				end
			end

			-- Camera
			local alpha = math.clamp(aim.smooth / 100, 0.02, 1)
			alpha = 1 - (1 - alpha) ^ (dt * 60) -- không phụ thuộc tốc độ khung hình
			local desired
			if aim.cam then
				-- Góc nhìn sau lưng nhân vật (đứng đối diện mục tiêu), nhìn về mục tiêu
				if cam.CameraType ~= Enum.CameraType.Scriptable then
					cam.CameraType = Enum.CameraType.Scriptable
					camChanged = true
				end
				local away = Vector3.new(myRoot.Position.X - part.Position.X, 0, myRoot.Position.Z - part.Position.Z)
				away = (away.Magnitude > 0.1) and away.Unit or -myRoot.CFrame.LookVector
				local camPos = myRoot.Position + away * aim.camBack + Vector3.new(0, aim.camUp, 0)
				desired = CFrame.lookAt(camPos, part.Position)
			else
				desired = CFrame.lookAt(cam.CFrame.Position, part.Position)
			end
			cam.CFrame = cam.CFrame:Lerp(desired, alpha)
		end

		stopAim = function()
			local was = aim.on
			aim.on = false
			aim.target = nil
			pcall(function() RunService:UnbindFromRenderStep("AtomAimbot") end)
			clearMarker()
			restoreRotate()
			restoreCamera()
			if aimRb then roundVisual(aimRb, false) end
			setAimStatus("Chưa khoá ai. Bấm nút tròn để khoá mục tiêu gần tâm màn hình.")
			return was
		end

		local function startAim()
			if aim.on then return end
			local ent
			if aim.chosen then
				ent = entityOf(aim.chosen)
				if not ent then
					notify("Lock-on", aim.chosen.DisplayName .. " chưa có nhân vật hoặc đã chết.", 3, "warn")
					return
				end
			else
				ent = getClosest()
				if not ent then
					notify("Lock-on", "Không có mục tiêu nào trong tầm nhìn.", 2, "warn")
					return
				end
			end
			aim.target = ent
			aim.on = true
			RunService:BindToRenderStep("AtomAimbot", Enum.RenderPriority.Camera.Value + 1, aimStep)
			roundVisual(aimRb, true)
			setAimStatus("Đang khoá: " .. targetName(ent) .. " (bấm nút lần nữa để nhả)")
		end

		aimRb = makeRoundButton({
			name = "AimButton",
			icon = "target",
			fallback = "◎",
			posKey = "jjs.aimBtnPos",
			defaultPos = UDim2.new(1, -90, 0.5, 107),
			isLocked = function() return aimLocked end,
			onClick = function()
				if aim.on then stopAim() else startAim() end
			end,
		})
		Theme.aimBtn = aimRb.btn

		-- Vòng nhấp nháy quanh nút: đỏ = chưa khoá, xanh lá = đang khoá
		do
			local pulse = create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = Color3.fromRGB(255, 40, 40),
				BackgroundTransparency = 0.45,
				BorderSizePixel = 0,
				ZIndex = -1,
			}, aimRb.btn)
			create("UICorner", { CornerRadius = UDim.new(0.5, 0) }, pulse)
			table.insert(connections, RunService.Heartbeat:Connect(function()
				if not aimRb.btn.Visible then return end
				local a = (os.clock() % 0.8) / 0.8
				local s = 1 + 0.35 * a
				pulse.Size = UDim2.fromScale(s, s)
				pulse.BackgroundColor3 = aim.on and Color3.fromRGB(0, 255, 80) or Color3.fromRGB(255, 40, 40)
				pulse.BackgroundTransparency = 0.45 + 0.55 * a
			end))
		end

		-- ---------- Giao diện ----------
		local aimCard = addCard(jjsPage, "Lock-on (khoá mục tiêu)")
		Persist.nextKey = "jjs.aim"
		handles.aimArm = addToggle(aimCard, "Bật Lock-on (hiện nút tròn)", false, function(on)
			aimRb.btn.Visible = on
			if not on then stopAim() end
		end)
		Persist.nextKey = "jjs.aimLock"
		addToggle(aimCard, "Khoá vị trí nút Lock-on", false, function(on)
			aimLocked = on
			aimRb.badge.Visible = on
		end)

		-- Chọn người từ danh sách (có tìm kiếm)
		create("TextLabel", {
			Size = UDim2.new(1, 0, 0, 18),
			BackgroundTransparency = 1,
			Text = "Chọn người để khoá (gõ để tìm)",
			TextColor3 = TEXT,
			Font = Enum.Font.GothamBold,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, aimCard)
		aimChosenLabel = addText(aimCard, "")
		setChosenLabel()
		aimPicker = addPlayerPicker(aimCard, {
			height = 150,
			onSelect = function(plr)
				aim.chosen = plr
				setChosenLabel()
				-- Đang khoá mà bạn chọn người khác -> chuyển sang người đó
				if aim.on then
					local ent = entityOf(plr)
					if ent then
						aim.target = ent
						setAimStatus("Đang khoá: " .. targetName(ent) .. " (bấm nút lần nữa để nhả)")
					end
				end
			end,
		})
		addButton(aimCard, "Bỏ chọn (lần bấm sau khoá mục tiêu gần tâm)", function()
			aim.chosen = nil
			setChosenLabel()
			aimPicker:Set(nil)
		end)
		addButton(aimCard, "Đổi sang mục tiêu gần tâm ngay", function()
			if not aim.on then
