	}

	-- Chuỗi có số: {mẫu Lua, hàm dựng câu}
	local PATS = {
		{ "^Không tải được bundle %(mã (.+)%)%.$", function(a) return "Couldn't load bundle (code " .. a .. ")." end },
		{ "^Bundle: (.+) — (%d+) animation, bấm vào một animation để gán%.$",
			function(a, b) return "Bundle: " .. a .. " — " .. b .. " animation(s), click one to assign it." end },
		{ "^Tùy chỉnh %(ID (%d+)%)$", function(a) return "Custom (ID " .. a .. ")" end },
		{ "^Cửa: (%d+) • Prompt: (%d+) • Điểm cuối: (%d+) • firetouchinterest: (.+)$",
			function(a, b, c, d)
				return "Doors: " .. a .. " • Prompts: " .. b .. " • End points: " .. c
					.. " • firetouchinterest: " .. (d == "có" and "yes" or "no")
			end },
		{ "^Đã kết nối • (%d+) tin trong bin$", function(a) return "Connected • " .. a .. " message(s) in bin" end },
		{ "^Tối đa (%d+) ký tự, mỗi tin cách nhau (%d+) giây%. Tin nhắn không được lọc bởi Roblox%.$",
			function(a, b) return "Max " .. a .. " characters, " .. b .. " seconds between messages. Messages are not filtered by Roblox." end },
		{ "^Tin quá dài %(tối đa (%d+) ký tự%)%.$", function(a) return "Message too long (max " .. a .. " characters)." end },
		{ "^(%d+) / (%d+) bài$", function(a, b) return a .. " / " .. b .. " songs" end },
		{ "^Bài (%d+)$", function(a) return "Song " .. a end },
		{ "^Điểm (%d+)$", function(a) return "Point " .. a end },
		{ "^Thử sai quá nhiều lần, đợi (%d+) giây%.$", function(a) return "Too many wrong attempts, wait " .. a .. " seconds." end },
		{ "^Đã khôi phục (%d+) cài đặt%.$", function(a) return "Restored " .. a .. " setting(s)." end },
		{ "^Nội dung viết lên bảng %(tối đa (%d+) ký tự%)%.%.%.$",
			function(a) return "Text to write on the board (max " .. a .. " characters)..." end },
	}

	tr = function(s)
		local e = EN[s]
		if e then return e end
		local n = #s
		for _, r in ipairs(RULES) do
			local pre, suf = r[1], r[2]
			local lp, ls = #pre, #suf
			if n >= lp + ls
				and string.sub(s, 1, lp) == pre
				and (ls == 0 or string.sub(s, n - ls + 1) == suf) then
				return r[3](string.sub(s, lp + 1, n - ls))
			end
		end
		for _, p in ipairs(PATS) do
			local res = { string.match(s, p[1]) }
			if #res > 0 then return p[2](table.unpack(res)) end
		end
		return nil
	end

	-- Đồng bộ một thuộc tính chữ của một đối tượng theo ngôn ngữ hiện tại
	local function sync(obj, prop, vAttr, eAttr)
		local cur = obj[prop]
		if lang == "en" then
			if cur == obj:GetAttribute(eAttr) then return end
			local t = tr(cur)
			if t and t ~= cur then
				obj:SetAttribute(vAttr, cur)
				obj:SetAttribute(eAttr, t)
				obj[prop] = t
			else
				obj:SetAttribute(vAttr, nil)
				obj:SetAttribute(eAttr, nil)
			end
		else
			local e = obj:GetAttribute(eAttr)
			if e and cur == e then
				local v = obj:GetAttribute(vAttr)
				obj:SetAttribute(eAttr, nil)
				obj:SetAttribute(vAttr, nil)
				if v then obj[prop] = v end
			end
		end
	end

	local hooked = setmetatable({}, { __mode = "k" })
	local function prep(obj)
		local isBox = obj:IsA("TextBox")
		if not (isBox or obj:IsA("TextLabel") or obj:IsA("TextButton")) then return end
		if not hooked[obj] then
			hooked[obj] = true
			-- Ô nhập liệu: chỉ dịch chữ gợi ý, không đụng vào chữ người dùng gõ
			if not isBox then
				obj:GetPropertyChangedSignal("Text"):Connect(function() sync(obj, "Text", "ViText", "EnText") end)
			else
				obj:GetPropertyChangedSignal("PlaceholderText"):Connect(function()
					sync(obj, "PlaceholderText", "ViPh", "EnPh")
				end)
			end
		end
		if isBox then
			sync(obj, "PlaceholderText", "ViPh", "EnPh")
		else
			sync(obj, "Text", "ViText", "EnText")
		end
	end

	local function updateChips()
		for code, btn in pairs(Theme.langChips or {}) do
			if btn.Parent then
				local on = (code == lang)
				btn.BackgroundColor3 = on and Theme.accent or WHITE
				btn.BackgroundTransparency = on and 0.6 or 0.9
			end
		end
	end
	table.insert(Theme.hooks, updateChips)

	gui.DescendantAdded:Connect(function(d)
		if lang == "en" then prep(d) end
	end)

	Theme.setLanguage = function(code, noSave)
		if code ~= "vi" and code ~= "en" then return end
		lang = code
		if not noSave then Persist.set("settings.language", code) end
		for _, d in ipairs(gui:GetDescendants()) do prep(d) end
		updateChips()
		if not noSave then
			notify(code == "en" and "Language" or "Ngôn ngữ",
				code == "en" and "Switched to English." or "Đã chuyển sang Tiếng Việt.", 2, "success", true)
		end
	end

	updateChips()
	if Persist.restore("settings.language", "vi") == "en" then
		Theme.setLanguage("en", true)
	end
end

