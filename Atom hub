	addText(chatCard, "Tối đa " .. MAX_LEN .. " ký tự, mỗi tin cách nhau " .. SEND_COOLDOWN .. " giây. Tin nhắn không được lọc bởi Roblox.")

	local function setStatus(t)
		statusLabel.Text = t
	end

	-- ================= HTTP / JSONBIN =================
	local function configProblem()
		if CHAT_JSONBIN_ID == "" then
			return "Chưa cấu hình: điền CHAT_JSONBIN_ID (và CHAT_JSONBIN_KEY) ở đầu file."
		end
		if not httpRequest then
			return "Môi trường này không hỗ trợ HTTP request nên chat global không dùng được."
		end
		return nil
	end

	local function call(method, url, body, extraHeaders)
		local headers = { ["Content-Type"] = "application/json" }
		if CHAT_JSONBIN_KEY ~= "" then headers[CHAT_KEY_HEADER] = CHAT_JSONBIN_KEY end
		for k, v in pairs(extraHeaders or {}) do headers[k] = v end
		local ok, res = pcall(httpRequest, { Url = url, Method = method, Headers = headers, Body = body })
		if not ok or type(res) ~= "table" then return nil, "không gửi được yêu cầu" end
		local code = res.StatusCode or res.status_code
		if type(code) == "number" and (code < 200 or code >= 300) then
			return nil, "HTTP " .. code
		end
		return res.Body or ""
	end

	local function fetchData()
		local body, err = call("GET", BASE .. "/latest", nil, { ["X-Bin-Meta"] = "false" })
		if not body then return nil, err end
		local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
		if not ok or type(data) ~= "table" then return nil, "dữ liệu bin không hợp lệ" end
		if type(data.record) == "table" then data = data.record end
		if type(data.messages) ~= "table" then data.messages = {} end
		return data
	end

	-- Đọc bin, thêm tin, ghi lại. Không ghi nếu đọc thất bại (tránh xoá mất tin của người khác).
	local function pushMessage(text)
		local data, err = fetchData()
		if not data then return false, err end
		local msg = {
			id = HttpService:GenerateGUID(false),
			uid = player.UserId,
			name = string.sub(player.DisplayName, 1, 30),
			sender = player.Name, -- tương thích với script chat cũ (đọc "sender" + "text")
			text = text,
			ts = os.time(),
		}
		table.insert(data.messages, msg)
		while #data.messages > MAX_MESSAGES do table.remove(data.messages, 1) end
		local body, err2 = call("PUT", BASE, HttpService:JSONEncode(data))
		if not body then return false, err2 end
		return true, msg
	end

	-- ================= HIỂN THỊ TIN NHẮN =================
	local function clean(text, maxLen)
		text = tostring(text or "")
		text = string.gsub(text, "%c", " ")
		local ok, cut = pcall(utf8.offset, text, maxLen + 1)
		if ok and cut then text = string.sub(text, 1, cut - 1) end
		return text
	end

	local function scrollToBottom()
		task.defer(function()
			chatList.CanvasPosition = Vector2.new(0, math.max(0, chatList.AbsoluteCanvasSize.Y - chatList.AbsoluteSize.Y))
		end)
	end

	-- Chuẩn hoá danh sách tin: hỗ trợ cả tin cũ dạng {sender, text} không có id/ts
	local function normalizeList(list)
		local out, counts = {}, {}
		for _, m in ipairs(list) do
			if type(m) == "table" then
				local name = m.name or m.sender or "?"
				local text = m.text or ""
				local id = m.id
				if type(id) ~= "string" then
					local base = tostring(m.sender or m.name or "?") .. "|" .. tostring(text)
					counts[base] = (counts[base] or 0) + 1
					id = "legacy|" .. base .. "|" .. counts[base]
				end
				local uid = m.uid
				if uid == nil and m.sender == player.Name then uid = player.UserId end
				table.insert(out, { id = id, uid = uid, name = name, text = text, ts = m.ts })
			end
		end
		return out
	end

	local function addMessage(m)
		if type(m) ~= "table" or type(m.id) ~= "string" or seen[m.id] then return false end
		seen[m.id] = true
		order += 1
		local mine = m.uid == player.UserId

		local item = create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = order,
		}, chatList)
		create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 1) }, item)

		local stamp = type(m.ts) == "number" and os.date("%H:%M", m.ts) or "--:--"
		local head = create("TextLabel", {
			Size = UDim2.new(1, 0, 0, 14),
			BackgroundTransparency = 1,
			Text = clean(m.name, 30) .. "  ·  " .. stamp,
			TextColor3 = mine and Theme.accent or SUBTEXT,
			Font = Enum.Font.GothamMedium,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = 1,
		}, item)
		if mine then Theme.track(head, "TextColor3") end
		create("TextLabel", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Text = clean(m.text, MAX_LEN),
			TextColor3 = TEXT,
			Font = Enum.Font.Gotham,
			TextSize = 13,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = 2,
		}, item)

		-- Giữ số tin hiển thị trong giới hạn
		local children = {}
		for _, c in ipairs(chatList:GetChildren()) do
			if c:IsA("Frame") then table.insert(children, c) end
		end
		table.sort(children, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
		while #children > MAX_RENDERED do
			table.remove(children, 1):Destroy()
		end

		scrollToBottom()
		return true
	end

	-- ================= CẬP NHẬT (POLLING) =================
	local polling = false
	local function pollOnce(firstLoad)
		local data, err = fetchData()
		if not data then
			setStatus("Lỗi kết nối: " .. tostring(err))
			return false
		end
		setStatus("Đã kết nối • " .. #data.messages .. " tin trong bin")
		for _, m in ipairs(normalizeList(data.messages)) do
			local isNew = not seen[m.id]
			addMessage(m)
			if isNew and not firstLoad and chatNotify and m.uid ~= player.UserId
				and (not visible or currentTab ~= "Chat") then
				notify("Chat • " .. clean(m.name, 20), clean(m.text, 60), 3, "info")
			end
		end
		return true
	end

	local function startPolling()
		if polling then return end
		polling = true
		task.spawn(function()
			local first = true
			while chatOn do
				local ok = pollOnce(first)
				first = false
				-- Mở tab Chat thì cập nhật nhanh; không thì chậm hơn để tiết kiệm lượt gọi API
				local wait = (visible and currentTab == "Chat") and chatInterval or chatInterval * 3
				if not ok then wait = wait * 2 end
				local t0 = os.clock()
				while chatOn and os.clock() - t0 < wait do task.wait(0.5) end
			end
			polling = false
		end)
	end

	-- ================= GỬI TIN =================
	local lastSend, sending = -999, false
	local function sendFromBox()
		if sending then return end
		local text = string.match(box.Text, "^%s*(.-)%s*$")
		if text == "" then return end
		if not chatOn then
			-- Tự bật chat (nếu cấu hình sai thì công tắc sẽ tự báo lỗi và chat vẫn tắt)
			if H.on then H.on:Set(true) end
			if not chatOn then return end
		end
		local n = utf8.len(text) or #text
		if n > MAX_LEN then
			notify("Chat", "Tin quá dài (tối đa " .. MAX_LEN .. " ký tự).", 3, "warn", true)
			return
		end
		if os.clock() - lastSend < SEND_COOLDOWN then
			notify("Chat", "Bạn gửi quá nhanh, đợi một chút.", 2, "warn", true)
			return
		end
		sending = true
		box.Text = ""
		task.spawn(function()
			local ok, res = pushMessage(text)
			sending = false
			if ok then
				lastSend = os.clock()
				addMessage(res)
			else
				box.Text = text
				notify("Chat", "Gửi thất bại: " .. tostring(res), 4, "error", true)
			end
		end)
	end
	sendBtn.MouseButton1Click:Connect(sendFromBox)
	box.FocusLost:Connect(function(enterPressed)
		if enterPressed then sendFromBox() end
	end)

	-- ================= CÀI ĐẶT CHAT =================
	local settingsCard = addCard(chatPage, "Cài đặt chat")
	Persist.nextKey = "chat.enabled"
	H.on = addToggle(settingsCard, "Bật chat global", false, function(on)
		if on then
			local problem = configProblem()
			if problem then
				chatOn = false
				setStatus(problem)
				notify("Chat", problem, 4, "error", true)
				task.defer(function()
					if H.on then H.on:Set(false, true) end
				end)
				return
			end
			chatOn = true
			setStatus("Đang kết nối...")
			startPolling()
		else
			chatOn = false
			setStatus("Chat đang tắt.")
		end
	end)
	Persist.nextKey = "chat.notify"
	addToggle(settingsCard, "Báo tin mới khi đang ở tab khác", true, function(on)
		chatNotify = on
	end)
	Persist.nextKey = "chat.interval"
	addSlider(settingsCard, "Tần suất cập nhật (giây)", 3, 30, 6, function(v)
		chatInterval = v
	end)
	addText(settingsCard, "Cập nhật càng nhanh càng tốn lượt gọi API của JSONBin (gói miễn phí có giới hạn). Khi bạn không mở tab Chat, script tự cập nhật chậm hơn 3 lần.")
	addButton(settingsCard, "Làm mới ngay", function()
		if not chatOn then
			notify("Chat", "Chat đang tắt.", 2, "warn", true)
			return
		end
		task.spawn(pollOnce, false)
	end)

	-- Cho Info/Settings biết trạng thái cấu hình ngay khi mở
	local problem = configProblem()
	if problem then setStatus(problem) end

	gui.Destroying:Connect(function()
		chatOn = false
	end)
end

