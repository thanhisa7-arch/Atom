-- Các chức năng chạy phía client (chỉ ảnh hưởng máy của bạn). Một số game có thể tự reset giá trị.
do
	local RunService = game:GetService("RunService")
	local Lighting = game:GetService("Lighting")

	local function getHumanoid()
		local char = player.Character
		return char and char:FindFirstChildOfClass("Humanoid")
	end
	local function getRoot()
		local char = player.Character
		return char and char:FindFirstChild("HumanoidRootPart")
	end

	-- Giá trị gốc để khôi phục
	local hum0 = getHumanoid()
	local cam0 = workspace.CurrentCamera
	local DEFAULT_SPEED = hum0 and math.floor(hum0.WalkSpeed + 0.5) or 16
	local DEFAULT_JUMP = hum0 and math.floor(hum0.JumpPower + 0.5) or 50
	local DEFAULT_FOV = cam0 and math.floor(cam0.FieldOfView + 0.5) or 70
	local ORIGINAL_GRAVITY = workspace.Gravity
	local DEFAULT_GRAVITY = math.clamp(math.floor(ORIGINAL_GRAVITY + 0.5), 0, 400)

	local F = {
		speed = DEFAULT_SPEED, jump = DEFAULT_JUMP, fov = DEFAULT_FOV,
		infJump = false, noclip = false, fly = false, flySpeed = 60, farming = false, farmSpeed = 80,
	}

	-- ===== Noclip =====
	local noclipOriginal = {}
	local function setNoclip(on)
		F.noclip = on
		if not on then
			for part, orig in pairs(noclipOriginal) do
				if part and part.Parent then part.CanCollide = orig end
			end
			noclipOriginal = {}
		end
	end
	table.insert(connections, RunService.Stepped:Connect(function()
		if not F.noclip then return end
		local char = player.Character
		if not char then return end
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") then
				if noclipOriginal[d] == nil then noclipOriginal[d] = d.CanCollide end
				d.CanCollide = false
			end
		end
	end))

	-- ===== Bay =====
	local flyObjs = {}
	local function stopFly()
		for _, o in pairs(flyObjs) do o:Destroy() end
		flyObjs = {}
		local hum = getHumanoid()
		if hum then hum.PlatformStand = false end
	end
	local function startFly()
		local root, hum = getRoot(), getHumanoid()
		if not root or not hum then return false end
		stopFly()
		local att = Instance.new("Attachment")
		att.Name = "AtomFlyAtt"
		att.Parent = root
		local lv = Instance.new("LinearVelocity")
		lv.Attachment0 = att
		lv.MaxForce = math.huge
		lv.VectorVelocity = Vector3.zero
		lv.Parent = root
		local ao = Instance.new("AlignOrientation")
		ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
		ao.Attachment0 = att
		ao.MaxTorque = math.huge
		ao.Responsiveness = 40
		ao.Parent = root
		flyObjs = { att = att, lv = lv, ao = ao }
		hum.PlatformStand = true
		return true
	end
	table.insert(connections, RunService.RenderStepped:Connect(function()
		local cam = workspace.CurrentCamera
		if cam and F.fov ~= DEFAULT_FOV then cam.FieldOfView = F.fov end

		if F.fly and flyObjs.lv and flyObjs.lv.Parent then
			local hum = getHumanoid()
			if not cam or not hum then return end
			-- Hướng bay theo camera (nhìn lên/xuống thì bay lên/xuống)
			local rel = cam.CFrame:VectorToObjectSpace(hum.MoveDirection)
			local dir = cam.CFrame.RightVector * rel.X + cam.CFrame.LookVector * (-rel.Z)
			if RealUIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
			if RealUIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.yAxis end
			if dir.Magnitude > 1 then dir = dir.Unit end
			flyObjs.lv.VectorVelocity = dir * F.flySpeed
			flyObjs.ao.CFrame = CFrame.lookAt(Vector3.zero, cam.CFrame.LookVector)
		end
	end))

	-- ===== Tốc độ / sức nhảy (giữ giá trị khi game cố reset) =====
	table.insert(connections, RunService.Heartbeat:Connect(function()
		local hum = getHumanoid()
		if not hum then return end
		if F.speed ~= DEFAULT_SPEED and not F.fly and not F.farming then hum.WalkSpeed = F.speed end
		if F.farming then hum.WalkSpeed = F.farmSpeed end -- giữ tốc độ bot dù game cố reset
		if F.jump ~= DEFAULT_JUMP then
			hum.UseJumpPower = true
			hum.JumpPower = F.jump
		end
	end))

	-- ===== Nhảy vô hạn =====
	table.insert(connections, RealUIS.JumpRequest:Connect(function()
		if F.infJump then
			local hum = getHumanoid()
			if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
		end
	end))

	-- Hồi sinh: bật lại bay nếu đang bật
	table.insert(connections, player.CharacterAdded:Connect(function(char)
		flyObjs = {}
		task.spawn(function()
			char:WaitForChild("HumanoidRootPart")
			char:WaitForChild("Humanoid")
			if F.fly then startFly() end
		end)
	end))

	-- ===== Ánh sáng =====
	local lightingBackup
	local function setFullbright(on)
		if on then
			if not lightingBackup then
				lightingBackup = {
					Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime,
					FogEnd = Lighting.FogEnd, GlobalShadows = Lighting.GlobalShadows,
					Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient,
				}
			end
			Lighting.Brightness = 2
			Lighting.ClockTime = 14
			Lighting.FogEnd = 1e6
			Lighting.GlobalShadows = false
			Lighting.Ambient = Color3.fromRGB(178, 178, 178)
			Lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178)
		elseif lightingBackup then
			for k, v in pairs(lightingBackup) do Lighting[k] = v end
			lightingBackup = nil
		end
	end

	-- ===== Khôi phục khi menu bị đóng =====
	gui.Destroying:Connect(function()
		F.fly = false
		stopFly()
		setNoclip(false)
		setFullbright(false)
		workspace.Gravity = ORIGINAL_GRAVITY
		local hum = getHumanoid()
		if hum then
			hum.WalkSpeed = DEFAULT_SPEED
			hum.JumpPower = DEFAULT_JUMP
		end
		local cam = workspace.CurrentCamera
		if cam then cam.FieldOfView = DEFAULT_FOV end
	end)

	-- ================= NÚT BAY (tròn) =================
	-- Công tắc "Bật chế độ bay" chỉ HIỆN nút này. Bấm nút tròn để bắt đầu / dừng bay.
	local flyLocked = false
