	-- ===== BẢNG NHẬP KEY =====
	local unlocked = false
	local fails, lockUntil = 0, 0
	local promptWin, keyBox, errLbl

	local function shake(win)
		local base = win.Position
		task.spawn(function()
			for _, dx in ipairs({ -9, 9, -6, 6, 0 }) do
				tweenEx(win, 0.05, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {
					Position = UDim2.new(base.X.Scale, base.X.Offset + dx, base.Y.Scale, base.Y.Offset),
				})
				task.wait(0.05)
			end
		end)
	end

	local function openSecret()
		if not secretMenu then
			local ok, res = pcall(buildSecretMenu)
			if not ok then
				warn("[Atom Menu] Lỗi menu bí mật: " .. tostring(res))
				return
			end
			secretMenu = res
		end
		secretMenu.open()
	end

	local function submitKey()
		local text = string.match(keyBox.Text, "^%s*(.-)%s*$") or ""
		if os.clock() < lockUntil then
			errLbl.Text = "Thử sai quá nhiều lần, đợi " .. math.ceil(lockUntil - os.clock()) .. " giây."
			shake(promptWin.win)
			return
		end
		if text == SECRET_KEY then
			unlocked = true
			fails = 0
			errLbl.Text = ""
			keyBox.Text = ""
			promptWin.close()
			notify("🤫 Secret", "Key đúng! Đã mở menu bí mật.", 3, "success", true)
			openSecret()
		else
			fails += 1
			if fails >= 5 then
				fails = 0
				lockUntil = os.clock() + 15
				errLbl.Text = "Sai 5 lần. Khoá 15 giây."
			else
				errLbl.Text = "Key không đúng."
			end
			keyBox.Text = ""
			shake(promptWin.win)
		end
	end

	local function buildPrompt()
		local m = makeWindow("AtomSecretPrompt", 300, 200, "🔒  Nhập key")
		local body = create("Frame", {
			Size = UDim2.new(1, 0, 1, -44),
			Position = UDim2.fromOffset(0, 44),
			BackgroundTransparency = 1,
		}, m.win)
		padding(body, 6, 16, 14, 16)
		create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 10) }, body)

		local hint = addText(body, "Nhập key để mở menu bí mật.")
		hint.LayoutOrder = 1

		keyBox = create("TextBox", {
			Size = UDim2.new(1, 0, 0, 36),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.92,
			Text = "",
			PlaceholderText = "Key...",
			PlaceholderColor3 = SUBTEXT,
			TextColor3 = TEXT,
			Font = Enum.Font.GothamMedium,
			TextSize = 14,
			ClearTextOnFocus = false,
			LayoutOrder = 2,
		}, body)
		corner(keyBox, 8)
		padding(keyBox, 0, 10, 0, 10)

		local openB = addButton(body, "Mở khoá", submitKey)
		openB.LayoutOrder = 3

		errLbl = addText(body, "")
		errLbl.TextColor3 = Color3.fromRGB(230, 90, 90)
		errLbl.TextSize = 12
		errLbl.LayoutOrder = 4

		keyBox.FocusLost:Connect(function(enterPressed)
			if enterPressed then submitKey() end
		end)
		return m
	end

	profileBtn.MouseButton1Click:Connect(function()
		if unlocked then
			if secretMenu and secretMenu.opened then
				secretMenu.close()
			else
				openSecret()
			end
			return
		end
		if not promptWin then promptWin = buildPrompt() end
		if promptWin.opened then
			promptWin.close()
		else
			errLbl.Text = ""
			promptWin.open()
			task.delay(0.15, function()
				if promptWin.opened and keyBox then keyBox:CaptureFocus() end
			end)
		end
	end)
